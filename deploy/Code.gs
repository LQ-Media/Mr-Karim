/**
 * Pokok Keluarga -- the whole server, in one file.
 *
 * Generated by tools/build-deploy-bundle.js from the fifteen source files in
 * apps-script/. Edit those, not this: run the script again to rebuild.
 *
 * Paste this into Code.gs in the Apps Script editor, paste Index.html into an
 * HTML file named Index, and follow docs/SETUP.md from step 3.
 */

/* ================================================================== *
 * 00_Config.gs                                                   *
 * ================================================================== */

/**
 * Configuration and the sheet schema.
 *
 * The schema lives here rather than in the spreadsheet so that a fresh install
 * builds its own tabs and headers. Nobody should have to prepare a spreadsheet
 * by hand before the app will run, and nobody should have to keep one in sync
 * with the code afterwards.
 */

var CFG = {
  APP_NAME: 'Pokok Keluarga',
  SCHEMA_VERSION: 1,

  /* Property keys. Set once at install, read on every request. */
  PROP_SHEET_ID: 'FAMILY_SHEET_ID',
  PROP_FOLDER_ID: 'PHOTO_FOLDER_ID',
  PROP_CLIENT_ID: 'OAUTH_CLIENT_ID',
  PROP_OWNER_EMAIL: 'OWNER_EMAIL',
  PROP_WEBAPP_URL: 'WEBAPP_URL',

  CACHE_GRAPH_KEY: 'graph_v1',
  CACHE_SECONDS: 300,

  /* Google caps a single cache entry at 100KB, so a large tree is split across
   * numbered chunks and reassembled on read. */
  CACHE_CHUNK_BYTES: 90000,
  CACHE_MAX_CHUNKS: 40,

  PHOTO_MAX_BYTES: 8 * 1024 * 1024,
  PHOTO_MAX_EDGE: 1200,

  ROLES: ['owner', 'admin', 'member', 'pending', 'blocked'],
  LANGS: ['ms', 'en', 'ar']
};

/**
 * Every tab, in the order they are created, with their columns.
 *
 * Adding a column here and redeploying is enough: the bootstrap appends any
 * header the sheet does not already have, and never reorders or removes the
 * ones that are there, so existing data survives a schema change.
 */
var SCHEMA = {
  People: ['person_id', 'display_name', 'full_name', 'given_name', 'patronym',
    'patronym_type', 'also_known_as', 'honorific', 'gender', 'birth_date',
    'birth_precision', 'birth_place', 'birth_order', 'birth_order_source',
    'is_living', 'death_date', 'death_precision', 'death_place', 'burial_place',
    'email', 'mobile', 'address', 'country', 'occupation', 'notes',
    'photo_file_id', 'photo_thumb_id', 'map_x', 'map_y',
    'status', 'merged_into_id',
    'created_by', 'created_at', 'updated_by', 'updated_at'],

  Parentage: ['link_id', 'child_id', 'parent_id', 'parent_role', 'relation_type',
    'status', 'created_by', 'created_at'],

  Unions: ['union_id', 'partner_a_id', 'partner_b_id', 'union_type', 'status',
    'start_date', 'end_date', 'place', 'order_index', 'notes',
    'created_by', 'created_at'],

  Users: ['email', 'person_id', 'role', 'lang_pref', 'can_invite', 'invited_by',
    'invited_at', 'last_login_at', 'status'],

  Invites: ['invite_id', 'email', 'token', 'prebind_person_id', 'invited_by',
    'created_at', 'expires_at', 'used_at', 'status'],

  PendingChanges: ['change_id', 'kind', 'target_id', 'payload_json', 'summary',
    'requested_by', 'requested_at', 'status', 'reviewed_by', 'reviewed_at',
    'review_note'],

  MergeQueue: ['candidate_id', 'person_a_id', 'person_b_id', 'score',
    'signals_json', 'detected_at', 'status', 'resolved_by', 'resolved_at'],

  CustomTitles: ['title_id', 'from_person_id', 'to_person_id', 'custom_label',
    'lang', 'created_by', 'created_at'],

  AuditLog: ['log_id', 'ts', 'actor_email', 'action', 'entity', 'entity_id',
    'detail_json'],

  Settings: ['key', 'value']
};

/** Seeded on first run so the owner can change behaviour without editing code. */
var DEFAULT_SETTINGS = {
  family_name: 'Keluarga',
  birth_order_titles: 'Long,Ngah,Alang,Anjang,Andak,Uda,Uteh',
  merge_auto_threshold: '92',
  merge_queue_threshold: '68',
  match_suggest_threshold: '55',
  default_lang: 'ms',
  allow_member_invites: 'TRUE',
  invite_expiry_days: '30',
  /* Off by default. Reading someone's Google Photos is a sensitive scope, so
   * switching this on has consequences for the OAuth consent screen that the
   * owner should choose deliberately -- see docs/GOOGLE-PHOTOS.md. */
  enable_google_photos: 'FALSE'
};

/** The id prefix each table counts from. */
var ID_PREFIX = {
  People: 'P', Parentage: 'L', Unions: 'U', Invites: 'I',
  PendingChanges: 'C', MergeQueue: 'M', CustomTitles: 'T', AuditLog: 'A'
};

/* ================================================================== *
 * 01_Store.gs                                                    *
 * ================================================================== */

/**
 * Spreadsheet access.
 *
 * Everything reads whole tabs at once and writes in batches. Apps Script
 * charges roughly the same for reading one cell as for reading a thousand, so
 * per-row access is what makes these apps feel slow; the whole family is
 * cheaper to fetch in one call and index in memory.
 */

function ST_props() {
  return PropertiesService.getScriptProperties();
}

function ST_spreadsheet() {
  var id = ST_props().getProperty(CFG.PROP_SHEET_ID);
  if (!id) throw new Error('Not installed yet. Run installFamilyTree() from the editor.');
  return SpreadsheetApp.openById(id);
}

function ST_sheet(name) {
  var sheet = ST_spreadsheet().getSheetByName(name);
  if (!sheet) throw new Error('Missing tab: ' + name + '. Re-run installFamilyTree().');
  return sheet;
}

/**
 * Creates any missing tab and appends any missing column.
 *
 * Safe to run repeatedly. Columns are only ever added, never moved or removed,
 * so a schema change in a later version cannot destroy data already entered.
 */
function ST_bootstrap(spreadsheet) {
  for (var name in SCHEMA) {
    if (!Object.prototype.hasOwnProperty.call(SCHEMA, name)) continue;
    var wanted = SCHEMA[name];
    var sheet = spreadsheet.getSheetByName(name);

    if (!sheet) {
      sheet = spreadsheet.insertSheet(name);
      sheet.getRange(1, 1, 1, wanted.length).setValues([wanted]);
      sheet.setFrozenRows(1);
      sheet.getRange(1, 1, 1, wanted.length).setFontWeight('bold');
      continue;
    }

    var lastColumn = Math.max(sheet.getLastColumn(), 1);
    var existing = sheet.getRange(1, 1, 1, lastColumn).getValues()[0];
    var missing = [];
    for (var i = 0; i < wanted.length; i++) {
      if (existing.indexOf(wanted[i]) === -1) missing.push(wanted[i]);
    }
    if (missing.length) {
      sheet.getRange(1, lastColumn + 1, 1, missing.length).setValues([missing]);
      sheet.getRange(1, 1, 1, lastColumn + missing.length).setFontWeight('bold');
    }
    sheet.setFrozenRows(1);
  }

  var defaultSheet = spreadsheet.getSheetByName('Sheet1');
  if (defaultSheet && spreadsheet.getSheets().length > 1) spreadsheet.deleteSheet(defaultSheet);
}

/** Reads a whole tab as row objects keyed by header name. */
function ST_readAll(name) {
  var sheet = ST_sheet(name);
  var lastRow = sheet.getLastRow();
  var lastColumn = sheet.getLastColumn();
  if (lastRow < 2 || lastColumn < 1) return [];

  var values = sheet.getRange(1, 1, lastRow, lastColumn).getValues();
  var headers = values[0];
  var rows = [];

  for (var r = 1; r < values.length; r++) {
    var row = {};
    var empty = true;
    for (var c = 0; c < headers.length; c++) {
      if (!headers[c]) continue;
      var value = values[r][c];
      if (value instanceof Date) value = ST_toIsoDate(value);
      else if (value !== '' && value !== null) empty = false;
      row[headers[c]] = value === null ? '' : value;
    }
    if (!empty) {
      row.__row = r + 1; // The physical sheet row, for targeted updates.
      rows.push(row);
    }
  }
  return rows;
}

/** Dates come back from Sheets as Date objects in the script's timezone; the
 *  rest of the app compares them as plain ISO strings. */
function ST_toIsoDate(date) {
  return Utilities.formatDate(date, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function ST_now() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ss");
}

function ST_headers(name) {
  var sheet = ST_sheet(name);
  return sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
}

/** Appends one row, filling only the columns present in the object. */
function ST_append(name, obj) {
  var sheet = ST_sheet(name);
  var headers = ST_headers(name);
  var row = [];
  for (var i = 0; i < headers.length; i++) {
    row.push(obj[headers[i]] === undefined ? '' : obj[headers[i]]);
  }
  sheet.appendRow(row);
  ST_invalidate();
  return obj;
}

/** Appends many rows in one write. */
function ST_appendMany(name, objects) {
  if (!objects.length) return;
  var sheet = ST_sheet(name);
  var headers = ST_headers(name);
  var rows = [];
  for (var i = 0; i < objects.length; i++) {
    var row = [];
    for (var c = 0; c < headers.length; c++) {
      row.push(objects[i][headers[c]] === undefined ? '' : objects[i][headers[c]]);
    }
    rows.push(row);
  }
  sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, headers.length).setValues(rows);
  ST_invalidate();
}

/**
 * Updates the row whose key column holds `keyValue`, writing only the supplied
 * fields. Returns false when no such row exists.
 */
function ST_update(name, keyColumn, keyValue, changes) {
  var sheet = ST_sheet(name);
  var headers = ST_headers(name);
  var keyIndex = headers.indexOf(keyColumn);
  if (keyIndex === -1) throw new Error('No column ' + keyColumn + ' on ' + name);

  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return false;

  var keys = sheet.getRange(2, keyIndex + 1, lastRow - 1, 1).getValues();
  for (var i = 0; i < keys.length; i++) {
    if (String(keys[i][0]) !== String(keyValue)) continue;

    var rowNumber = i + 2;
    var current = sheet.getRange(rowNumber, 1, 1, headers.length).getValues()[0];
    for (var field in changes) {
      if (!Object.prototype.hasOwnProperty.call(changes, field)) continue;
      var column = headers.indexOf(field);
      if (column !== -1) current[column] = changes[field];
    }
    sheet.getRange(rowNumber, 1, 1, headers.length).setValues([current]);
    ST_invalidate();
    return true;
  }
  return false;
}

/**
 * The next id for a table, as a zero-padded string.
 *
 * Ids are taken from the highest existing number rather than the row count, so
 * that a merged or hidden row never causes an id to be handed out twice.
 */
function ST_nextId(name) {
  var prefix = ID_PREFIX[name] || 'X';
  var sheet = ST_sheet(name);
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return prefix + '00001';

  var idColumn = ST_headers(name).indexOf(SCHEMA[name][0]) + 1;
  var values = sheet.getRange(2, idColumn, lastRow - 1, 1).getValues();
  var highest = 0;
  for (var i = 0; i < values.length; i++) {
    var digits = String(values[i][0]).replace(/\D/g, '');
    var n = parseInt(digits, 10);
    if (!isNaN(n) && n > highest) highest = n;
  }
  var next = String(highest + 1);
  while (next.length < 5) next = '0' + next;
  return prefix + next;
}

/* ------------------------------------------------------------------ *
 * Settings
 * ------------------------------------------------------------------ */

function ST_settings() {
  var rows = ST_readAll('Settings');
  var out = {};
  for (var key in DEFAULT_SETTINGS) {
    if (Object.prototype.hasOwnProperty.call(DEFAULT_SETTINGS, key)) out[key] = DEFAULT_SETTINGS[key];
  }
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].key) out[rows[i].key] = rows[i].value;
  }
  return out;
}

function ST_setSetting(key, value) {
  if (!ST_update('Settings', 'key', key, { value: value })) {
    ST_append('Settings', { key: key, value: value });
  }
  ST_invalidate();
}

/* ------------------------------------------------------------------ *
 * Graph cache
 * ------------------------------------------------------------------ */

/**
 * The relationship graph, from cache when possible.
 *
 * Rebuilding means reading four tabs and indexing them, which is fast but not
 * free, and the home screen alone needs the graph for every card it draws.
 * Any write invalidates the cache rather than trying to patch it -- a stale
 * tree is a wrong tree, and correctness is worth one extra read.
 */
function ST_graph() {
  var cached = ST_cacheGet(CFG.CACHE_GRAPH_KEY);
  if (cached) {
    try {
      return REL_buildGraph(JSON.parse(cached));
    } catch (err) {
      ST_invalidate();
    }
  }

  var data = {
    people: ST_readAll('People'),
    parentage: ST_readAll('Parentage'),
    unions: ST_readAll('Unions'),
    customTitles: ST_readAll('CustomTitles')
  };
  ST_cachePut(CFG.CACHE_GRAPH_KEY, JSON.stringify(data));
  return REL_buildGraph(data);
}

function ST_invalidate() {
  try {
    var cache = CacheService.getScriptCache();
    var keys = [CFG.CACHE_GRAPH_KEY + '_meta'];
    for (var i = 0; i < CFG.CACHE_MAX_CHUNKS; i++) keys.push(CFG.CACHE_GRAPH_KEY + '_' + i);
    cache.removeAll(keys);
  } catch (err) {
    // A cache that cannot be cleared only costs a rebuild; never fail a write for it.
  }
}

/** Cache entries are capped at 100KB each, so anything larger is chunked. */
function ST_cachePut(key, text) {
  try {
    var cache = CacheService.getScriptCache();
    var chunks = [];
    for (var i = 0; i < text.length; i += CFG.CACHE_CHUNK_BYTES) {
      chunks.push(text.substring(i, i + CFG.CACHE_CHUNK_BYTES));
    }
    if (chunks.length > CFG.CACHE_MAX_CHUNKS) return; // Too big to cache; read through instead.

    var entries = {};
    for (var c = 0; c < chunks.length; c++) entries[key + '_' + c] = chunks[c];
    entries[key + '_meta'] = String(chunks.length);
    cache.putAll(entries, CFG.CACHE_SECONDS);
  } catch (err) {
    // Caching is an optimisation. Losing it must never lose a request.
  }
}

function ST_cacheGet(key) {
  try {
    var cache = CacheService.getScriptCache();
    var count = cache.get(key + '_meta');
    if (!count) return null;

    var wanted = [];
    for (var i = 0; i < Number(count); i++) wanted.push(key + '_' + i);
    var parts = cache.getAll(wanted);

    var text = '';
    for (var j = 0; j < wanted.length; j++) {
      if (parts[wanted[j]] === undefined) return null; // A chunk expired; treat as a miss.
      text += parts[wanted[j]];
    }
    return text;
  } catch (err) {
    return null;
  }
}

/* ------------------------------------------------------------------ *
 * Audit
 * ------------------------------------------------------------------ */

function ST_audit(actorEmail, action, entity, entityId, detail) {
  try {
    ST_append('AuditLog', {
      log_id: ST_nextId('AuditLog'),
      ts: ST_now(),
      actor_email: actorEmail || '',
      action: action,
      entity: entity || '',
      entity_id: entityId || '',
      detail_json: detail ? JSON.stringify(detail).substring(0, 40000) : ''
    });
  } catch (err) {
    // The log is a record, not a gate. A failure to write it must not roll back
    // the change it was describing.
  }
}

/* ================================================================== *
 * 02_Auth.gs                                                     *
 * ================================================================== */

/**
 * Authentication and permissions.
 *
 * The script is deployed to execute as its owner, so the Sheet and the photo
 * folder are never shared with relatives -- they reach the data only through
 * this code. That choice rules out Apps Script's own Session.getActiveUser():
 * when a script runs as its owner, that call returns an empty string for any
 * visitor outside the owner's Workspace domain, which is exactly who the
 * relatives will be.
 *
 * It also rules out the Google Identity Services button, for a less obvious
 * reason. Apps Script serves its pages inside a sandbox iframe on a generated
 * googleusercontent.com origin that changes between deployments, and Google
 * Identity Services will only run on JavaScript origins registered in advance.
 * There is no origin to register.
 *
 * So sign-in is done the long way round, which turns out to be the robust way.
 * The visitor is sent to Google at the top level, Google returns them to this
 * web app's own /exec URL -- a fixed, registerable address -- and the
 * authorization code is exchanged for an identity server-side, where the client
 * secret can safely live. The result is a signed session token that the browser
 * presents on every later call.
 */

var AUTH_AUTH_ENDPOINT = 'https://accounts.google.com/o/oauth2/v2/auth';
var AUTH_TOKEN_ENDPOINT = 'https://oauth2.googleapis.com/token';
var AUTH_SESSION_HOURS = 12;
var AUTH_STATE_MINUTES = 120;

/* Reading someone's Google Photos needs its own consent, asked for only when
 * they actually reach for it. Signing in to look at the family tree should not
 * demand access to a person's photo library. */
var AUTH_PHOTOS_SCOPE = 'https://www.googleapis.com/auth/photospicker.mediaitems.readonly';

/* ------------------------------------------------------------------ *
 * The sign-in round trip
 * ------------------------------------------------------------------ */

function AUTH_clientId() {
  var id = ST_props().getProperty(CFG.PROP_CLIENT_ID);
  if (!id) throw new Error('Sign-in is not configured yet. See docs/SETUP.md.');
  return id;
}

/**
 * Where Google sends people back to.
 *
 * Stored rather than derived. ScriptApp.getService().getUrl() returns the /dev
 * URL when called from the editor, and on a Workspace account it can return a
 * domain-scoped /a/<domain>/ form -- so the value used here would not match the
 * one registered in the Cloud Console, and the exchange fails with an error
 * that explains nothing. The owner records the exact string they registered.
 */
function AUTH_redirectUri() {
  var stored = ST_props().getProperty(CFG.PROP_WEBAPP_URL);
  if (stored) return stored;
  return ScriptApp.getService().getUrl();
}

/**
 * Where to send someone to sign in.
 *
 * `state` is signed and timestamped so a callback that did not originate here
 * is rejected -- without it, a link could walk a signed-in visitor through a
 * sign-in they did not start.
 */
function AUTH_signInUrl() {
  return AUTH_buildAuthUrl('openid email profile', { purpose: 'signin' });
}

/**
 * Consent to read the photos this person picks.
 *
 * Asked for separately, and only at the moment somebody chooses to add a photo
 * from Google Photos. The state carries which person the photo is for, so the
 * app can carry on where it left off when Google sends them back.
 *
 * No session token goes into this URL. It would travel through Google's
 * redirect and land in browser history; the browser already holds the session
 * and picks it up again when the page reloads.
 */
function AUTH_photosAuthUrl(personId) {
  return AUTH_buildAuthUrl('openid email ' + AUTH_PHOTOS_SCOPE,
    { purpose: 'photos', personId: String(personId || '') });
}

function AUTH_buildAuthUrl(scope, statePayload) {
  var params = {
    client_id: AUTH_clientId(),
    redirect_uri: AUTH_redirectUri(),
    response_type: 'code',
    scope: scope,
    state: AUTH_makeState(statePayload),
    include_granted_scopes: 'true'
  };
  var parts = [];
  for (var key in params) {
    if (Object.prototype.hasOwnProperty.call(params, key)) {
      parts.push(key + '=' + encodeURIComponent(params[key]));
    }
  }
  return AUTH_AUTH_ENDPOINT + '?' + parts.join('&');
}

function AUTH_makeState(payload) {
  var state = { n: Utilities.getUuid(), exp: AUTH_epoch() + AUTH_STATE_MINUTES * 60 };
  for (var key in (payload || {})) {
    if (Object.prototype.hasOwnProperty.call(payload, key)) state[key] = payload[key];
  }
  return AUTH_sign(state);
}

/**
 * Handles Google's redirect back to the app.
 *
 * The authorization code is exchanged over TLS directly with Google's token
 * endpoint, so the identity in the response is trustworthy without verifying
 * the JWT signature ourselves -- but the audience and expiry are still checked,
 * because a token minted for a different application must never be accepted.
 */
function AUTH_completeSignIn(code, state) {
  var checkedState = AUTH_verify(state);
  if (!checkedState) throw new Error('That sign-in link has expired. Please try again.');
  if (checkedState.purpose === 'photos') throw new Error('That link was for photos, not sign-in.');

  var body = AUTH_exchangeCode(code);
  if (!body.id_token) throw new Error('Google did not return an identity.');

  var claims = AUTH_readIdToken(body.id_token);
  if (claims.aud !== AUTH_clientId()) throw new Error('Sign-in rejected.');
  if (String(claims.email_verified) !== 'true') throw new Error('Your Google email is not verified.');
  if (Number(claims.exp) <= AUTH_epoch()) throw new Error('That sign-in has already expired.');

  return AUTH_sign({
    email: String(claims.email).toLowerCase(),
    name: claims.name || '',
    picture: claims.picture || '',
    exp: AUTH_epoch() + AUTH_SESSION_HOURS * 3600
  });
}

/** Reads the claims out of a JWT that Google just handed us over TLS. */
function AUTH_readIdToken(idToken) {
  var parts = String(idToken).split('.');
  if (parts.length !== 3) throw new Error('Google returned an identity we could not read.');
  var payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');
  while (payload.length % 4) payload += '=';
  return JSON.parse(Utilities.newBlob(Utilities.base64Decode(payload)).getDataAsString());
}

/**
 * Completes the Google Photos consent and keeps the resulting access token.
 *
 * Held in the cache against the person's email for slightly less than its own
 * lifetime, and never written to the spreadsheet: it is a key to somebody's
 * entire photo library and has no business outliving the few minutes it is
 * needed for.
 */
function AUTH_completePhotosGrant(code, state) {
  var checked = AUTH_verify(state);
  if (!checked || checked.purpose !== 'photos') {
    throw new Error('That link has expired. Please try again.');
  }

  var body = AUTH_exchangeCode(code);
  if (!body.access_token) throw new Error('Google did not grant access to your photos.');
  if (!body.id_token) throw new Error('Google did not say who granted it.');

  var claims = AUTH_readIdToken(body.id_token);
  if (claims.aud !== AUTH_clientId()) throw new Error('Sign-in rejected.');

  var email = String(claims.email).toLowerCase();
  var lifetime = Math.max(60, Math.min(Number(body.expires_in || 3600) - 120, 3000));
  CacheService.getUserCache().put('photos_tok_' + email, body.access_token, lifetime);
  CacheService.getScriptCache().put('photos_tok_' + email, body.access_token, lifetime);

  return { email: email, personId: checked.personId || '' };
}

/** The Photos access token for this caller, if the consent is still live. */
function AUTH_photosToken(email) {
  var key = 'photos_tok_' + String(email).toLowerCase();
  return CacheService.getUserCache().get(key) ||
         CacheService.getScriptCache().get(key) || null;
}

function AUTH_exchangeCode(code) {
  var secret = ST_props().getProperty('OAUTH_CLIENT_SECRET');
  if (!secret) throw new Error('Sign-in is not configured yet. See docs/SETUP.md.');

  var response = UrlFetchApp.fetch(AUTH_TOKEN_ENDPOINT, {
    method: 'post',
    muteHttpExceptions: true,
    payload: {
      code: code,
      client_id: AUTH_clientId(),
      client_secret: secret,
      redirect_uri: AUTH_redirectUri(),
      grant_type: 'authorization_code'
    }
  });
  if (response.getResponseCode() !== 200) {
    // Google's own words, not ours. The common failure here is a redirect_uri
    // that differs between the sign-in link and this exchange, and a generic
    // "please try again" sends the person round the same loop for ever.
    throw new Error('Google rejected the sign-in: ' + AUTH_tokenError(response) +
      '\n\nRedirect URI used: ' + AUTH_redirectUri());
  }
  return JSON.parse(response.getContentText());
}

/** What Google said went wrong, without echoing anything we sent it. */
function AUTH_tokenError(response) {
  try {
    var body = JSON.parse(response.getContentText());
    var code = body.error || 'unknown_error';
    return body.error_description ? code + ' (' + body.error_description + ')' : code;
  } catch (err) {
    return 'HTTP ' + response.getResponseCode();
  }
}

/* ------------------------------------------------------------------ *
 * Session tokens
 * ------------------------------------------------------------------ */

/**
 * Sessions are signed rather than stored.
 *
 * A server-side session table would mean either a cache that silently evicts
 * people mid-visit or another sheet to write on every request. A token the
 * server signs and re-checks needs neither, and it cannot be forged without the
 * secret, which never leaves Script Properties.
 */
function AUTH_secret() {
  var props = ST_props();
  var secret = props.getProperty('SESSION_SECRET');
  if (!secret) {
    secret = Utilities.getUuid() + Utilities.getUuid();
    props.setProperty('SESSION_SECRET', secret);
  }
  return secret;
}

function AUTH_sign(payload) {
  var body = Utilities.base64EncodeWebSafe(JSON.stringify(payload));
  var mac = Utilities.base64EncodeWebSafe(
    Utilities.computeHmacSha256Signature(body, AUTH_secret()));
  return body + '.' + mac;
}

function AUTH_verify(token) {
  if (!token || typeof token !== 'string' || token.length > 4096) return null;
  var parts = token.split('.');
  if (parts.length !== 2) return null;

  var expected = Utilities.base64EncodeWebSafe(
    Utilities.computeHmacSha256Signature(parts[0], AUTH_secret()));
  if (!AUTH_constantTimeEquals(parts[1], expected)) return null;

  var payload;
  try {
    payload = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString());
  } catch (err) {
    return null;
  }
  if (!payload.exp || Number(payload.exp) <= AUTH_epoch()) return null;
  return payload;
}

/** Compares without leaking how much of the signature matched. */
function AUTH_constantTimeEquals(a, b) {
  if (a.length !== b.length) return false;
  var diff = 0;
  for (var i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

function AUTH_epoch() {
  return Math.floor(Date.now() / 1000);
}

/* ------------------------------------------------------------------ *
 * Who is calling
 * ------------------------------------------------------------------ */

/**
 * Resolves a session token into a user, creating a pending record for a
 * first-time visitor so their access request reaches the admin.
 */
function AUTH_session(sessionToken) {
  var identity = AUTH_verify(sessionToken);
  if (!identity || !identity.email) throw new Error('Sign-in expired. Please sign in again.');

  var users = ST_readAll('Users');
  var user = null;
  for (var i = 0; i < users.length; i++) {
    if (String(users[i].email).toLowerCase() === identity.email) { user = users[i]; break; }
  }

  if (!user) user = AUTH_admitOrQueue(identity);

  if (user.status === 'suspended' || user.role === 'blocked') {
    throw new Error('Your access to the family tree has been withdrawn.');
  }

  ST_update('Users', 'email', user.email, { last_login_at: ST_now() });

  return {
    email: user.email,
    personId: user.person_id || null,
    role: user.role,
    lang: user.lang_pref || ST_settings().default_lang || 'ms',
    canInvite: String(user.can_invite).toUpperCase() === 'TRUE',
    name: identity.name,
    picture: identity.picture,
    isAdmin: user.role === 'owner' || user.role === 'admin',
    isPending: user.role === 'pending'
  };
}

/**
 * A visitor nobody has heard of.
 *
 * If they were invited they are admitted immediately and bound to whichever
 * record the invitation named. Otherwise they are recorded as pending, which
 * shows them a holding screen and puts them in the admin's queue -- they see
 * nothing of the family until someone approves them.
 */
function AUTH_admitOrQueue(identity) {
  var invite = AUTH_findInvite(identity.email);
  var settings = ST_settings();

  var row = {
    email: identity.email,
    person_id: invite ? (invite.prebind_person_id || '') : '',
    role: invite ? 'member' : 'pending',
    lang_pref: settings.default_lang || 'ms',
    can_invite: invite && String(settings.allow_member_invites).toUpperCase() === 'TRUE'
      ? 'TRUE' : 'FALSE',
    invited_by: invite ? invite.invited_by : '',
    invited_at: ST_now(),
    last_login_at: ST_now(),
    status: 'active'
  };

  ST_append('Users', row);
  if (invite) {
    ST_update('Invites', 'invite_id', invite.invite_id, { used_at: ST_now(), status: 'used' });
  }
  ST_audit(identity.email, invite ? 'join_via_invite' : 'access_requested',
    'Users', identity.email, null);
  return row;
}

function AUTH_findInvite(email) {
  var invites = ST_readAll('Invites');
  var now = ST_now();
  for (var i = 0; i < invites.length; i++) {
    var invite = invites[i];
    if (invite.status !== 'open') continue;
    if (String(invite.email).toLowerCase() !== email) continue;
    if (invite.expires_at && String(invite.expires_at) < now) continue;
    return invite;
  }
  return null;
}

/* ------------------------------------------------------------------ *
 * Permissions
 * ------------------------------------------------------------------ */

/**
 * Who a member may edit without an admin's approval.
 *
 * A parent entering their own family should not have to wait for anyone: their
 * household, the generation above and everything below them is theirs to
 * maintain. Reaching sideways -- a cousin's children, an aunt's second marriage
 * -- is where a shared tree gets damaged by well-meaning guesses, so those
 * edits become proposals instead of writes.
 *
 * Siblings are deliberately outside the direct scope. Each adult maintains
 * their own record, and a sibling who needs something changed can propose it.
 */
function AUTH_editableScope(graph, personId) {
  var scope = {};
  if (!personId) return scope;
  scope[personId] = 'self';

  var spouses = KIN_spousesOf(graph, personId);
  for (var i = 0; i < spouses.length; i++) scope[spouses[i].personId] = 'spouse';

  var parents = KIN_parentsOf(graph, personId);
  for (var j = 0; j < parents.length; j++) scope[parents[j]] = 'parent';

  var frontier = KIN_childrenOf(graph, personId);
  var depth = 0;
  while (frontier.length && depth < 6) {
    var next = [];
    for (var k = 0; k < frontier.length; k++) {
      if (scope[frontier[k]]) continue;
      scope[frontier[k]] = 'descendant';
      // A descendant's spouse marries into the household, so they are in scope.
      var theirSpouses = KIN_spousesOf(graph, frontier[k]);
      for (var s = 0; s < theirSpouses.length; s++) {
        if (!scope[theirSpouses[s].personId]) {
          scope[theirSpouses[s].personId] = 'descendant_spouse';
        }
      }
      next = next.concat(KIN_childrenOf(graph, frontier[k]));
    }
    frontier = next;
    depth++;
  }

  return scope;
}

function AUTH_canEditDirectly(session, graph, targetPersonId) {
  if (session.isAdmin) return true;
  if (session.isPending || !session.personId) return false;
  return !!AUTH_editableScope(graph, session.personId)[targetPersonId];
}

function AUTH_requireActive(session) {
  if (session.isPending) throw new Error('Your request to join is still waiting for approval.');
  if (!session.personId) throw new Error('Your account is not linked to anyone in the tree yet.');
}

function AUTH_requireAdmin(session) {
  if (!session.isAdmin) throw new Error('Only a family tree admin can do that.');
}

/* ================================================================== *
 * 03_People.gs                                                   *
 * ================================================================== */

/**
 * Writes: people, parent links and marriages.
 *
 * Two rules shape everything here.
 *
 * First, a person is never created on their own. Every new record arrives
 * attached to somebody already in the tree, as their child, parent, spouse or
 * sibling. A floating person is how a family tree quietly splits into two
 * disconnected halves, and refusing to create one removes the problem rather
 * than detecting it later.
 *
 * Second, a write outside the author's own branch becomes a proposal. The
 * payload is stored exactly as submitted and applied unchanged on approval, so
 * what the admin approves is what happens.
 */

var PPL_RELATIONSHIPS = ['child_of', 'parent_of', 'spouse_of', 'sibling_of'];

var PPL_EDITABLE_FIELDS = ['display_name', 'full_name', 'given_name', 'also_known_as',
  'honorific', 'gender', 'birth_date', 'birth_precision', 'birth_place', 'birth_order',
  'is_living', 'death_date', 'death_precision', 'death_place', 'burial_place',
  'email', 'mobile', 'address', 'country', 'occupation', 'notes'];

/**
 * Creates a person, or proposes one.
 *
 * `anchorId` is who they are being attached to and `relationship` is how. When
 * the author may edit the anchor, the record is written immediately; otherwise
 * the whole request is queued for an admin, who gets the same duplicate
 * warnings the author saw.
 */
function PPL_createPerson(session, anchorId, relationship, data, options) {
  AUTH_requireActive(session);
  if (PPL_RELATIONSHIPS.indexOf(relationship) === -1) {
    throw new Error('Unknown relationship: ' + relationship);
  }

  var graph = ST_graph();
  var anchor = graph.people[anchorId];
  if (!anchor) throw new Error('The person you are adding to no longer exists.');

  var clean = PPL_sanitise(data);
  if (!clean.display_name) throw new Error('A name is required.');

  // Offer an existing record before creating a new one, unless the author has
  // already looked at the suggestions and said none of them is the same person.
  if (!(options && options.ignoreDuplicates)) {
    var settings = ST_settings();
    var candidates = MTC_findCandidates(graph, clean, Number(settings.match_suggest_threshold) || 55, 5);
    if (candidates.length) {
      return {
        status: 'possible_duplicate',
        candidates: PPL_describeCandidates(graph, session, candidates),
        pending: { anchorId: anchorId, relationship: relationship, data: clean }
      };
    }
  }

  if (!AUTH_canEditDirectly(session, graph, anchorId)) {
    var change = PPL_queueChange(session, 'create_person', anchorId, {
      anchorId: anchorId, relationship: relationship, data: clean
    }, PPL_summariseCreate(graph, anchor, relationship, clean));
    return { status: 'pending_approval', changeId: change.change_id };
  }

  var created = PPL_applyCreate(session.email, anchorId, relationship, clean);
  return { status: 'created', personId: created.person_id, person: created };
}

/**
 * Writes the first person in an empty tree.
 *
 * Kept separate from PPL_applyCreate because that function requires an anchor,
 * and requiring one is the whole reason floating duplicates cannot happen. This
 * is the single documented exception, guarded by api_startTree.
 */
function PPL_applyRoot(actorEmail, clean) {
  var personId = ST_nextId('People');
  var parsed = MTC_parseName(clean.full_name || clean.display_name);

  var person = {};
  for (var i = 0; i < PPL_EDITABLE_FIELDS.length; i++) {
    person[PPL_EDITABLE_FIELDS[i]] = clean[PPL_EDITABLE_FIELDS[i]] === undefined
      ? '' : clean[PPL_EDITABLE_FIELDS[i]];
  }
  person.person_id = personId;
  person.patronym = parsed.patronym.join(' ');
  person.patronym_type = parsed.type;
  if (!person.gender && parsed.genderHint) person.gender = parsed.genderHint;
  if (!person.gender) person.gender = 'U';
  person.birth_order_source = clean.birth_order ? 'manual' : 'derived';
  person.is_living = clean.is_living === 'FALSE' ? 'FALSE' : 'TRUE';
  person.status = 'active';
  person.created_by = actorEmail;
  person.created_at = ST_now();
  person.updated_by = actorEmail;
  person.updated_at = ST_now();

  ST_append('People', person);
  ST_audit(actorEmail, 'start_tree', 'People', personId, null);
  ST_invalidate();
  return person;
}

/**
 * Performs the write. Shared by the direct path, by approval and by a batch.
 *
 * `alreadyLocked` is passed by a caller that holds the script lock already.
 * Taking it twice in one execution is not reliably reentrant in Apps Script,
 * and a deadlock here would strand someone mid-way through entering a family.
 */
function PPL_applyCreate(actorEmail, anchorId, relationship, clean, alreadyLocked) {
  var lock = alreadyLocked ? null : LockService.getScriptLock();
  if (lock) lock.waitLock(20000);
  try {
    var personId = ST_nextId('People');
    var parsed = MTC_parseName(clean.full_name || clean.display_name);

    var person = {};
    for (var i = 0; i < PPL_EDITABLE_FIELDS.length; i++) {
      var field = PPL_EDITABLE_FIELDS[i];
      person[field] = clean[field] === undefined ? '' : clean[field];
    }
    person.person_id = personId;
    person.patronym = parsed.patronym.join(' ');
    person.patronym_type = parsed.type;
    // A name that says 'binti' tells us the gender when nobody selected one.
    if (!person.gender && parsed.genderHint) person.gender = parsed.genderHint;
    if (!person.gender) person.gender = 'U';
    person.birth_order_source = clean.birth_order ? 'manual' : 'derived';
    person.is_living = clean.is_living === false || clean.is_living === 'FALSE' ? 'FALSE' : 'TRUE';
    person.status = 'active';
    person.merged_into_id = '';
    person.created_by = actorEmail;
    person.created_at = ST_now();
    person.updated_by = actorEmail;
    person.updated_at = ST_now();

    ST_append('People', person);
    PPL_link(actorEmail, anchorId, personId, relationship, clean);
    ST_audit(actorEmail, 'create_person', 'People', personId,
      { anchor: anchorId, relationship: relationship });

    ST_invalidate();
    return person;
  } finally {
    if (lock) lock.releaseLock();
  }
}

/** Creates the parent links or marriage implied by how the person was added. */
function PPL_link(actorEmail, anchorId, personId, relationship, data) {
  var graph = ST_graph();

  if (relationship === 'child_of') {
    var anchorRole = PPL_roleOf(graph.people[anchorId]);
    PPL_addParentLink(actorEmail, personId, anchorId, anchorRole, data.relation_type);
    // A child added to one parent belongs to that parent's current marriage too,
    // which is almost always what the person entering it means.
    var spouses = KIN_spousesOf(graph, anchorId);
    for (var i = 0; i < spouses.length; i++) {
      if (spouses[i].status === 'current') {
        PPL_addParentLink(actorEmail, personId, spouses[i].personId,
          PPL_roleOf(graph.people[spouses[i].personId]), data.relation_type);
        break;
      }
    }
    return;
  }

  if (relationship === 'parent_of') {
    PPL_addParentLink(actorEmail, anchorId, personId, PPL_roleOf(data), data.relation_type);
    return;
  }

  if (relationship === 'spouse_of') {
    PPL_addUnion(actorEmail, anchorId, personId, data);
    return;
  }

  if (relationship === 'sibling_of') {
    var parents = graph.parentsOf[anchorId] || [];
    if (!parents.length) {
      throw new Error('Add their parents first -- a sibling is recorded by sharing parents.');
    }
    for (var p = 0; p < parents.length; p++) {
      PPL_addParentLink(actorEmail, personId, parents[p].parent_id,
        parents[p].parent_role, parents[p].relation_type);
    }
  }
}

function PPL_roleOf(person) {
  if (!person) return 'guardian';
  if (person.gender === 'F') return 'mother';
  if (person.gender === 'M') return 'father';
  return 'guardian';
}

function PPL_addParentLink(actorEmail, childId, parentId, role, relationType) {
  if (childId === parentId) throw new Error('Someone cannot be their own parent.');

  var graph = ST_graph();
  // A cycle would make the ancestor walk run forever and is always a mistake.
  var ancestors = KIN_ancestorMap(graph, parentId);
  if (ancestors[childId]) {
    throw new Error('That would make the family tree loop back on itself.');
  }

  var existing = graph.parentsOf[childId] || [];
  for (var i = 0; i < existing.length; i++) {
    if (existing[i].parent_id === parentId) return existing[i];
  }

  var link = {
    link_id: ST_nextId('Parentage'),
    child_id: childId,
    parent_id: parentId,
    parent_role: role || 'guardian',
    relation_type: relationType || 'biological',
    status: 'active',
    created_by: actorEmail,
    created_at: ST_now()
  };
  ST_append('Parentage', link);
  return link;
}

function PPL_addUnion(actorEmail, aId, bId, data) {
  if (aId === bId) throw new Error('Someone cannot be married to themselves.');

  var graph = ST_graph();
  if (KIN_unionBetween(graph, aId, bId)) {
    throw new Error('That marriage is already recorded.');
  }

  var union = {
    union_id: ST_nextId('Unions'),
    partner_a_id: aId,
    partner_b_id: bId,
    union_type: data.union_type || 'nikah',
    status: data.union_status || 'current',
    start_date: data.union_start_date || '',
    end_date: data.union_end_date || '',
    place: data.union_place || '',
    order_index: (KIN_spousesOf(graph, aId).length + 1),
    notes: data.union_notes || '',
    created_by: actorEmail,
    created_at: ST_now()
  };
  ST_append('Unions', union);
  return union;
}

/* ------------------------------------------------------------------ *
 * Updates
 * ------------------------------------------------------------------ */

function PPL_updatePerson(session, personId, changes) {
  AUTH_requireActive(session);
  var graph = ST_graph();
  var person = graph.people[personId];
  if (!person) throw new Error('That person is no longer in the tree.');

  var clean = PPL_sanitise(changes);
  if (!Object.keys(clean).length) return { status: 'unchanged' };

  if (!AUTH_canEditDirectly(session, graph, personId)) {
    var change = PPL_queueChange(session, 'update_person', personId,
      { personId: personId, changes: clean },
      PPL_summariseUpdate(person, clean));
    return { status: 'pending_approval', changeId: change.change_id };
  }

  PPL_applyUpdate(session.email, personId, clean);
  return { status: 'updated', personId: personId };
}

function PPL_applyUpdate(actorEmail, personId, clean) {
  var before = ST_graph().people[personId];
  var patch = {};
  for (var field in clean) {
    if (Object.prototype.hasOwnProperty.call(clean, field)) patch[field] = clean[field];
  }

  if (patch.full_name || patch.display_name) {
    var parsed = MTC_parseName(patch.full_name || patch.display_name);
    patch.patronym = parsed.patronym.join(' ');
    patch.patronym_type = parsed.type;
  }
  if (patch.birth_order) patch.birth_order_source = 'manual';
  if (patch.is_living === 'FALSE' && !patch.death_date && !before.death_date) {
    patch.death_precision = patch.death_precision || 'unknown';
  }

  patch.updated_by = actorEmail;
  patch.updated_at = ST_now();

  ST_update('People', 'person_id', personId, patch);
  ST_audit(actorEmail, 'update_person', 'People', personId, { changes: clean });
  ST_invalidate();
}

/**
 * Field-level cleaning.
 *
 * Only known fields survive, so nothing a client sends can reach a column it
 * has no business writing -- role, status and merge pointers among them.
 */
function PPL_sanitise(data) {
  var out = {};
  if (!data) return out;

  for (var i = 0; i < PPL_EDITABLE_FIELDS.length; i++) {
    var field = PPL_EDITABLE_FIELDS[i];
    if (data[field] === undefined || data[field] === null) continue;
    var value = data[field];

    if (typeof value === 'string') {
      value = value.replace(/^\s+|\s+$/g, '').substring(0, field === 'notes' ? 5000 : 300);
    }
    if (field === 'gender') {
      value = String(value).toUpperCase();
      if (['M', 'F', 'U'].indexOf(value) === -1) value = 'U';
    }
    if (field === 'is_living') {
      value = (value === true || String(value).toUpperCase() === 'TRUE') ? 'TRUE' : 'FALSE';
    }
    if (field === 'birth_date' || field === 'death_date') {
      value = PPL_cleanDate(value);
      if (value === null) continue;
    }
    if (field === 'birth_order') {
      var n = parseInt(value, 10);
      if (isNaN(n) || n < 1 || n > 30) continue;
      value = n;
    }
    out[field] = value;
  }

  // Carry marriage details through so they reach PPL_addUnion untouched.
  var unionFields = ['union_type', 'union_status', 'union_start_date', 'union_end_date',
                     'union_place', 'union_notes', 'relation_type'];
  for (var u = 0; u < unionFields.length; u++) {
    if (data[unionFields[u]]) out[unionFields[u]] = String(data[unionFields[u]]).substring(0, 200);
  }
  return out;
}

function PPL_cleanDate(value) {
  if (!value) return '';
  var text = String(value).substring(0, 10);
  if (!/^\d{4}(-\d{2}(-\d{2})?)?$/.test(text)) return null;
  if (text.length === 4) text += '-01-01';
  if (text.length === 7) text += '-01';
  var year = Number(text.slice(0, 4));
  if (year < 1700 || year > new Date().getFullYear() + 1) return null;
  return text;
}

/* ------------------------------------------------------------------ *
 * Proposals
 * ------------------------------------------------------------------ */

function PPL_queueChange(session, kind, targetId, payload, summary) {
  var change = {
    change_id: ST_nextId('PendingChanges'),
    kind: kind,
    target_id: targetId || '',
    payload_json: JSON.stringify(payload),
    summary: summary,
    requested_by: session.email,
    requested_at: ST_now(),
    status: 'pending',
    reviewed_by: '',
    reviewed_at: '',
    review_note: ''
  };
  ST_append('PendingChanges', change);
  ST_audit(session.email, 'propose_' + kind, 'PendingChanges', change.change_id, payload);
  return change;
}

function PPL_summariseCreate(graph, anchor, relationship, data) {
  var wording = {
    child_of: 'as a child of', parent_of: 'as a parent of',
    spouse_of: 'as the spouse of', sibling_of: 'as a sibling of'
  };
  return 'Add ' + data.display_name + ' ' + wording[relationship] + ' ' + anchor.display_name;
}

function PPL_summariseUpdate(person, changes) {
  var parts = [];
  for (var field in changes) {
    if (Object.prototype.hasOwnProperty.call(changes, field)) {
      parts.push(field.replace(/_/g, ' ') + ' → ' + changes[field]);
    }
  }
  return 'Update ' + person.display_name + ': ' + parts.join(', ');
}

/** Duplicate suggestions, described the way the person entering data needs to
 *  see them: who this is, and how they already connect to the family. */
function PPL_describeCandidates(graph, session, candidates) {
  var out = [];
  var settings = ST_settings();
  for (var i = 0; i < candidates.length; i++) {
    var person = candidates[i].person;
    var father = MTC_fatherOf(graph, person.person_id);
    out.push({
      personId: person.person_id,
      name: person.display_name,
      fullName: person.full_name,
      birthDate: person.birth_date,
      birthPlace: person.birth_place,
      isLiving: person.is_living !== 'FALSE',
      photoId: person.photo_file_id,
      fatherName: father && graph.people[father] ? graph.people[father].display_name : '',
      yourTitle: session.personId
        ? TTL_title(graph, session.personId, person.person_id, session.lang, settings).label
        : '',
      score: candidates[i].score,
      why: PPL_explainSignals(candidates[i].signals)
    });
  }
  return out;
}

/** Turns scoring signals into something a relative can judge for themselves. */
function PPL_explainSignals(signals) {
  var wording = {
    father_matches: 'same father', same_father_record: 'same father on record',
    father_similar: 'similar father name', name_similar: 'very similar name',
    name_partial: 'similar name', nickname_match: 'matches a known nickname',
    birth_date: 'birth date agrees', email: 'same email', mobile: 'same phone number',
    address: 'same address', birth_place: 'same birthplace',
    shared_parent: 'same parents', shared_spouse: 'same spouse', shared_child: 'same child',
    gender_match: ''
  };
  var out = [];
  for (var i = 0; i < signals.length; i++) {
    var text = wording[signals[i].signal];
    if (text && signals[i].points > 0) out.push(text);
  }
  return out;
}

/* ------------------------------------------------------------------ *
 * Entering several people at once
 * ------------------------------------------------------------------ */

var PPL_BATCH_LIMIT = 25;

/**
 * Adds a whole set of children, or a whole set of siblings, in one go.
 *
 * Entering a family of two hundred one person at a time is the thing most
 * likely to kill a project like this before the tree is ever interesting, and
 * families do not recall themselves one person at a time. They recite a
 * generation in order: the eldest is Osman, then Fatimah, then Rahim.
 *
 * So the rows arrive oldest first and their position becomes their birth order,
 * which is exactly the fact the Malay titles need and the one thing the shape of
 * the tree can never supply. Capturing it as a side effect of how people
 * naturally list their family is far more reliable than asking for it.
 *
 * Every row is still checked against the tree. Where a row might already exist
 * nothing is written at all and the whole batch comes back for the author to
 * resolve, so a half-applied batch can never leave the tree in a state nobody
 * intended.
 */
function PPL_addBatch(session, anchorId, relationship, rows, decisions) {
  AUTH_requireActive(session);
  if (relationship !== 'child_of' && relationship !== 'sibling_of') {
    throw new Error('Only children or siblings can be added in a batch.');
  }
  if (!rows || !rows.length) throw new Error('Nobody was entered.');
  if (rows.length > PPL_BATCH_LIMIT) {
    throw new Error('Please add at most ' + PPL_BATCH_LIMIT + ' people at a time.');
  }

  var graph = ST_graph();
  var anchor = graph.people[anchorId];
  if (!anchor) throw new Error('The person you are adding to no longer exists.');

  var settings = ST_settings();
  var threshold = Number(settings.match_suggest_threshold) || 55;
  var cleaned = [];
  var needsReview = false;

  for (var i = 0; i < rows.length; i++) {
    var clean = PPL_sanitise(rows[i]);
    if (!clean.display_name) continue;

    var decision = (decisions && decisions[String(i)]) || null;
    var entry = { index: i, data: clean, decision: decision, candidates: [] };

    if (!decision) {
      entry.candidates = PPL_describeCandidates(
        graph, session, MTC_findCandidates(graph, clean, threshold, 4));
      if (entry.candidates.length) needsReview = true;
    }
    cleaned.push(entry);
  }

  if (!cleaned.length) throw new Error('Nobody was entered.');
  if (needsReview) {
    return {
      status: 'possible_duplicate',
      rows: cleaned.map(function (e) {
        return { index: e.index, name: e.data.display_name, candidates: e.candidates };
      })
    };
  }

  if (!AUTH_canEditDirectly(session, graph, anchorId)) {
    var change = PPL_queueChange(session, 'add_batch', anchorId,
      { anchorId: anchorId, relationship: relationship, rows: cleaned },
      'Add ' + cleaned.length + ' ' + (relationship === 'child_of' ? 'children' : 'siblings') +
      ' to ' + anchor.display_name);
    return { status: 'pending_approval', changeId: change.change_id };
  }

  return PPL_applyBatch(session.email, anchorId, relationship, cleaned);
}

function PPL_applyBatch(actorEmail, anchorId, relationship, entries) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var created = [];
    var linked = 0;
    var skipped = 0;

    // Continue the numbering from whoever is already recorded, so a generation
    // entered in two sittings still ends up in one sequence.
    var startOrder = PPL_highestBirthOrder(anchorId, relationship);

    for (var i = 0; i < entries.length; i++) {
      var entry = entries[i];
      var action = entry.decision ? entry.decision.action : 'create';

      if (action === 'skip') { skipped++; continue; }

      if (action === 'link' && entry.decision.personId) {
        PPL_link(actorEmail, anchorId, entry.decision.personId, relationship, entry.data);
        linked++;
        continue;
      }

      var data = entry.data;
      if (!data.birth_order) {
        data = PPL_withBirthOrder(data, startOrder + created.length + 1);
      }
      var person = PPL_applyCreate(actorEmail, anchorId, relationship, data, true);
      created.push(person.person_id);
    }

    ST_audit(actorEmail, 'add_batch', 'People', anchorId,
      { created: created.length, linked: linked, skipped: skipped });
    ST_invalidate();

    return { status: 'created', created: created.length, linked: linked, skipped: skipped };
  } finally {
    lock.releaseLock();
  }
}

function PPL_withBirthOrder(data, order) {
  var copy = {};
  for (var key in data) {
    if (Object.prototype.hasOwnProperty.call(data, key)) copy[key] = data[key];
  }
  copy.birth_order = order;
  return copy;
}

/** The highest rank already recorded among the siblings this batch joins. */
function PPL_highestBirthOrder(anchorId, relationship) {
  var graph = ST_graph();
  var existing = relationship === 'child_of'
    ? KIN_childrenOf(graph, anchorId)
    : KIN_siblingsOf(graph, anchorId).concat([anchorId]);

  var highest = 0;
  for (var i = 0; i < existing.length; i++) {
    var person = graph.people[existing[i]];
    var order = person ? Number(person.birth_order) : 0;
    if (order && order > highest) highest = order;
  }
  return highest || existing.length;
}

/**
 * Re-ranks a set of siblings.
 *
 * A generation entered out of order produces wrong titles -- the eldest uncle
 * called Pak Su -- and the family will notice immediately, because these words
 * are used daily. This is the correction, and it is deliberately a direct
 * statement of the order rather than an edit of one person's number, since the
 * ranks only mean anything relative to each other.
 */
function PPL_reorderSiblings(session, parentId, orderedIds) {
  AUTH_requireActive(session);
  var graph = ST_graph();
  if (!graph.people[parentId]) throw new Error('That person is no longer in the tree.');
  if (!AUTH_canEditDirectly(session, graph, parentId)) {
    throw new Error('Only a family tree admin, or someone closer to this family, can reorder them.');
  }

  var children = KIN_childrenOf(graph, parentId);
  for (var i = 0; i < orderedIds.length; i++) {
    if (children.indexOf(orderedIds[i]) === -1) {
      throw new Error('That person is not a child of ' + graph.people[parentId].display_name + '.');
    }
  }
  if (orderedIds.length !== children.length) {
    throw new Error('Every child must be included when reordering.');
  }

  for (var k = 0; k < orderedIds.length; k++) {
    ST_update('People', 'person_id', orderedIds[k], {
      birth_order: k + 1,
      birth_order_source: 'manual',
      updated_by: session.email,
      updated_at: ST_now()
    });
  }

  ST_audit(session.email, 'reorder_siblings', 'People', parentId, { order: orderedIds });
  ST_invalidate();
  return { status: 'reordered', count: orderedIds.length };
}

/* ------------------------------------------------------------------ *
 * Removing someone
 * ------------------------------------------------------------------ */

/**
 * Why this person cannot be removed, or '' when they can be.
 *
 * Shared by the detail view and the delete itself so the button a person sees
 * and the answer they get on pressing it can never disagree.
 */
function PPL_deleteBlockedReason(graph, session, personId) {
  var person = graph.people[personId];
  if (!person) return 'That person is no longer in the tree.';

  var children = KIN_childrenOf(graph, personId);
  if (children.length) {
    return 'They have ' + children.length + (children.length === 1 ? ' child' : ' children') +
      ' in the tree. Remove or reassign ' + (children.length === 1 ? 'that child' : 'those children') +
      ' first, so no branch is left floating.';
  }

  // Removing your own card is allowed -- the account is unbound with it and the
  // app asks who you are next time. Cutting somebody ELSE loose from their own
  // record is not yours to decide.
  var users = ST_readAll('Users');
  for (var i = 0; i < users.length; i++) {
    if (users[i].person_id !== personId) continue;
    if (users[i].status === 'removed') continue;
    if (String(users[i].email).toLowerCase() === String(session.email).toLowerCase()) continue;
    return 'A family member signs in as this person (' + users[i].email +
      '). Remove their account first.';
  }

  return '';
}

/**
 * Removes someone from the tree.
 *
 * The row is kept and marked, rather than erased. A family tree is a shared
 * record: a mistaken deletion should be recoverable from the sheet, and the
 * audit log should still say who removed whom.
 */
function PPL_deletePerson(session, personId) {
  AUTH_requireActive(session);
  var graph = ST_graph();
  var person = graph.people[personId];
  if (!person) throw new Error('That person is no longer in the tree.');

  var blocked = PPL_deleteBlockedReason(graph, session, personId);
  if (blocked) throw new Error(blocked);

  if (!AUTH_canEditDirectly(session, graph, personId)) {
    var change = PPL_queueChange(session, 'delete_person', personId,
      { personId: personId },
      'Remove ' + person.display_name + ' from the tree');
    return { status: 'pending_approval', changeId: change.change_id };
  }

  PPL_applyDelete(session.email, personId);
  return { status: 'deleted', personId: personId };
}

function PPL_applyDelete(actorEmail, personId) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var graph = ST_graph();
    var person = graph.people[personId];
    if (!person) throw new Error('That person is no longer in the tree.');

    var links = ST_readAll('Parentage');
    var removedLinks = 0;
    for (var i = 0; i < links.length; i++) {
      var link = links[i];
      if (link.status === 'removed') continue;
      if (link.child_id !== personId && link.parent_id !== personId) continue;
      ST_update('Parentage', 'link_id', link.link_id, { status: 'removed' });
      removedLinks++;
    }

    var unions = ST_readAll('Unions');
    var removedUnions = 0;
    for (var j = 0; j < unions.length; j++) {
      var union = unions[j];
      if (union.status === 'removed') continue;
      if (union.partner_a_id !== personId && union.partner_b_id !== personId) continue;
      ST_update('Unions', 'union_id', union.union_id, { status: 'removed' });
      removedUnions++;
    }

    ST_update('People', 'person_id', personId, {
      status: 'deleted',
      updated_by: actorEmail,
      updated_at: ST_now()
    });

    // An account left pointing at a removed person would open on a record that
    // is no longer there. Unbind it, and the app asks who they are next time.
    var accounts = ST_readAll('Users');
    for (var u = 0; u < accounts.length; u++) {
      if (accounts[u].person_id !== personId) continue;
      ST_update('Users', 'email', accounts[u].email, { person_id: '' });
    }

    ST_audit(actorEmail, 'delete_person', 'People', personId, {
      display_name: person.display_name,
      links_removed: removedLinks,
      unions_removed: removedUnions
    });
    ST_invalidate();
  } finally {
    lock.releaseLock();
  }
}

/* ================================================================== *
 * 04_Photos.gs                                                   *
 * ================================================================== */

/**
 * Portraits.
 *
 * Two constraints shape this. Apps Script cannot resize an image -- there is no
 * image API -- and it cannot serve one either, because a web app may only return
 * HTML, text or JSON, never image bytes.
 *
 * The usual workaround is to set each photo to "anyone with the link" and point
 * an <img> at Drive's thumbnail URL. That is fast, and it puts photographs of
 * the family's children behind nothing but an unguessable URL. So instead the
 * browser downscales before uploading, the files stay private to the owner's
 * Drive, and thumbnails are delivered as base64 through the same authenticated
 * call as everything else. A thumbnail is small enough that this is cheap, and
 * the full-size image is fetched only when someone opens a profile.
 */

function PHO_folder() {
  var id = ST_props().getProperty(CFG.PROP_FOLDER_ID);
  if (!id) throw new Error('Photo storage is not set up yet.');
  return DriveApp.getFolderById(id);
}

/**
 * Stores a portrait. Both sizes are produced by the browser; the server checks
 * them rather than trusting them.
 */
function PHO_upload(session, personId, payload) {
  AUTH_requireActive(session);
  var graph = ST_graph();
  var person = graph.people[personId];
  if (!person) throw new Error('That person is no longer in the tree.');

  if (!AUTH_canEditDirectly(session, graph, personId)) {
    var change = PPL_queueChange(session, 'upload_photo', personId,
      { personId: personId, payload: payload },
      'Add a photo of ' + person.display_name);
    return { status: 'pending_approval', changeId: change.change_id };
  }

  var stored = PHO_store(session.email, personId, payload);
  return { status: 'saved', thumb: stored.thumbDataUrl };
}

function PHO_store(actorEmail, personId, payload) {
  var mime = PHO_checkMime(payload.mime);
  var full = PHO_decode(payload.full, CFG.PHOTO_MAX_BYTES);
  var thumb = PHO_decode(payload.thumb, 400 * 1024);

  var folder = PHO_folder();
  var stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd-HHmmss');

  var fullFile = folder.createFile(
    Utilities.newBlob(full, mime, personId + '-' + stamp + '.jpg'));
  var thumbFile = folder.createFile(
    Utilities.newBlob(thumb, mime, personId + '-' + stamp + '-thumb.jpg'));

  // Replacing a portrait leaves the previous one in Drive rather than deleting
  // it. Family photographs are not always easy to find twice.
  ST_update('People', 'person_id', personId, {
    photo_file_id: fullFile.getId(),
    photo_thumb_id: thumbFile.getId(),
    updated_by: actorEmail,
    updated_at: ST_now()
  });
  ST_audit(actorEmail, 'upload_photo', 'People', personId, { file: fullFile.getId() });
  ST_invalidate();

  return {
    fileId: fullFile.getId(),
    thumbId: thumbFile.getId(),
    thumbDataUrl: 'data:' + mime + ';base64,' + Utilities.base64Encode(thumb)
  };
}

function PHO_checkMime(mime) {
  var allowed = ['image/jpeg', 'image/png', 'image/webp'];
  if (allowed.indexOf(mime) === -1) throw new Error('Photos must be JPEG, PNG or WebP.');
  return mime;
}

function PHO_decode(base64, limit) {
  if (!base64) throw new Error('No image was received.');
  var body = String(base64).replace(/^data:[^,]+,/, '');
  // Base64 carries roughly 3 bytes per 4 characters; check before decoding so a
  // huge payload cannot be expanded in memory first.
  if (body.length * 0.75 > limit) throw new Error('That photo is too large.');
  var bytes = Utilities.base64Decode(body);
  if (bytes.length > limit) throw new Error('That photo is too large.');
  return bytes;
}

/**
 * Thumbnails for a batch of people, as data URLs.
 *
 * Fetched for a whole screen at once. Drive reads are the slow part, so results
 * are cached per file; portraits change rarely and the cache key is the file id,
 * so a replaced photo simply has a different key.
 */
function PHO_thumbnails(session, personIds) {
  AUTH_requireActive(session);
  var graph = ST_graph();
  var cache = CacheService.getScriptCache();
  var out = {};

  var wanted = [];
  for (var i = 0; i < personIds.length && i < 60; i++) {
    var person = graph.people[personIds[i]];
    if (person && person.photo_thumb_id) {
      wanted.push({ personId: personIds[i], fileId: person.photo_thumb_id });
    }
  }
  if (!wanted.length) return out;

  var keys = [];
  for (var k = 0; k < wanted.length; k++) keys.push('thumb_' + wanted[k].fileId);
  var cached = cache.getAll(keys);

  var toCache = {};
  for (var w = 0; w < wanted.length; w++) {
    var key = 'thumb_' + wanted[w].fileId;
    if (cached[key]) {
      out[wanted[w].personId] = cached[key];
      continue;
    }
    try {
      var blob = DriveApp.getFileById(wanted[w].fileId).getBlob();
      var dataUrl = 'data:' + blob.getContentType() + ';base64,' +
                    Utilities.base64Encode(blob.getBytes());
      out[wanted[w].personId] = dataUrl;
      if (dataUrl.length < 90000) toCache[key] = dataUrl;
    } catch (err) {
      // A deleted or unreadable file just means no portrait on that card.
    }
  }
  if (Object.keys(toCache).length) {
    try { cache.putAll(toCache, 21600); } catch (err2) { /* optional */ }
  }
  return out;
}

/** The full-size portrait, fetched only when a profile is opened. */
function PHO_full(session, personId) {
  AUTH_requireActive(session);
  var person = ST_graph().people[personId];
  if (!person || !person.photo_file_id) return null;
  var blob = DriveApp.getFileById(person.photo_file_id).getBlob();
  return 'data:' + blob.getContentType() + ';base64,' + Utilities.base64Encode(blob.getBytes());
}

/* ================================================================== *
 * 05_Relations.gs                                                *
 * ================================================================== */

/**
 * Builds the in-memory relationship graph from raw sheet rows.
 *
 * The whole family is loaded at once and indexed. At family scale -- even a few
 * thousand people -- this costs a handful of Sheet reads and lets every
 * subsequent lookup run against plain objects, which is far cheaper than
 * querying the spreadsheet per person. The result is cached between requests.
 */

/**
 * @param data {{people, parentage, unions, customTitles}} arrays of row objects
 * @return the graph consumed by the kinship engine
 */
function REL_buildGraph(data) {
  var graph = {
    people: {},
    parentsOf: {},
    childrenOf: {},
    unionsOf: {},
    customTitles: data.customTitles || []
  };

  var people = data.people || [];
  for (var i = 0; i < people.length; i++) {
    var person = people[i];
    if (!person.person_id) continue;
    // Losers of a merge are followed, not shown; deleted people are gone from
    // the tree but kept in the sheet so a mistake can be undone.
    if (person.status === 'merged' || person.status === 'deleted') continue;
    graph.people[person.person_id] = person;
  }

  var links = data.parentage || [];
  for (var j = 0; j < links.length; j++) {
    var link = links[j];
    if (link.status === 'removed') continue;
    if (!graph.people[link.child_id] || !graph.people[link.parent_id]) continue;

    if (!graph.parentsOf[link.child_id]) graph.parentsOf[link.child_id] = [];
    graph.parentsOf[link.child_id].push(link);

    if (!graph.childrenOf[link.parent_id]) graph.childrenOf[link.parent_id] = [];
    graph.childrenOf[link.parent_id].push(link);
  }

  var unions = data.unions || [];
  for (var k = 0; k < unions.length; k++) {
    var union = unions[k];
    var a = union.partner_a_id;
    var b = union.partner_b_id;
    if (!graph.people[a] || !graph.people[b]) continue;

    if (!graph.unionsOf[a]) graph.unionsOf[a] = [];
    if (!graph.unionsOf[b]) graph.unionsOf[b] = [];
    graph.unionsOf[a].push(union);
    graph.unionsOf[b].push(union);
  }

  // Children are ordered oldest first everywhere they are displayed, which is
  // also the order the Malay birth-order titles depend on.
  for (var parentId in graph.childrenOf) {
    if (!Object.prototype.hasOwnProperty.call(graph.childrenOf, parentId)) continue;
    graph.childrenOf[parentId].sort(function (x, y) {
      return REL_compareBirth(graph.people[x.child_id], graph.people[y.child_id]);
    });
  }

  for (var pid in graph.unionsOf) {
    if (!Object.prototype.hasOwnProperty.call(graph.unionsOf, pid)) continue;
    graph.unionsOf[pid].sort(function (x, y) {
      return (Number(x.order_index) || 99) - (Number(y.order_index) || 99);
    });
  }

  return graph;
}

function REL_compareBirth(a, b) {
  if (!a || !b) return 0;
  var ao = Number(a.birth_order) || 0;
  var bo = Number(b.birth_order) || 0;
  if (ao && bo) return ao - bo;
  var ad = a.birth_date ? String(a.birth_date) : '';
  var bd = b.birth_date ? String(b.birth_date) : '';
  if (ad && bd) return ad < bd ? -1 : (ad > bd ? 1 : 0);
  if (ad) return -1;
  if (bd) return 1;
  return 0;
}

/**
 * Everyone within `radius` relationship steps of a person.
 *
 * Used both by the me-centred home screen and by the duplicate matcher, where a
 * shared relative is one of the strongest signals that two records are the same
 * human being.
 */
function REL_neighbourhood(graph, personId, radius) {
  var seen = {};
  seen[personId] = 0;
  var frontier = [personId];

  for (var step = 1; step <= (radius || 2); step++) {
    var next = [];
    for (var i = 0; i < frontier.length; i++) {
      var id = frontier[i];
      var touching = KIN_parentsOf(graph, id).concat(KIN_childrenOf(graph, id));

      var spouses = KIN_spousesOf(graph, id);
      for (var s = 0; s < spouses.length; s++) touching.push(spouses[s].personId);

      for (var t = 0; t < touching.length; t++) {
        if (seen[touching[t]] === undefined) {
          seen[touching[t]] = step;
          next.push(touching[t]);
        }
      }
    }
    frontier = next;
  }
  return seen;
}

/**
 * Follows merge redirects to the surviving record.
 *
 * After a merge the losing row stays in the sheet pointing at the winner, so
 * that any link, invite or old bookmark still resolves rather than breaking.
 */
function REL_resolveId(allPeopleById, personId) {
  var hops = 0;
  var current = personId;
  while (current && allPeopleById[current] && allPeopleById[current].merged_into_id && hops < 10) {
    current = allPeopleById[current].merged_into_id;
    hops++;
  }
  return current;
}

if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    REL_buildGraph: REL_buildGraph,
    REL_neighbourhood: REL_neighbourhood,
    REL_resolveId: REL_resolveId
  };
}

/* ================================================================== *
 * 06_Kinship.gs                                                  *
 * ================================================================== */

/**
 * Kinship engine.
 *
 * Turns a pair of people into the title one of them would use for the other.
 *
 * The database stores only neutral facts -- X fathered Y, A married B. Every
 * title in the interface is derived here, per viewer, at read time. "Uncle" is
 * not a property of a person; it is a property of a pair, and it changes
 * depending on who is looking.
 *
 * This file is plain ES5-compatible JavaScript with no Apps Script APIs, so the
 * same source is loaded directly by the Node test suite.
 */

/* ------------------------------------------------------------------ *
 * Ancestor traversal
 * ------------------------------------------------------------------ */

var KIN_MAX_DEPTH = 12;

/**
 * Walks up from a person through blood and adoptive parents.
 *
 * Returns a map from ancestor id to { depth, side, path }, where `path` is the
 * chain of ids from the starting person up to that ancestor inclusive, and
 * `side` is whether the first step went through the father or the mother.
 * Where an ancestor is reachable by several routes the shortest is kept, and a
 * person appearing on both sides of the family is marked 'both'.
 *
 * Step and foster links are deliberately not followed. A step-father's brother
 * is not your uncle by blood, and treating him as one would make two unrelated
 * families appear to be cousins.
 */
function KIN_ancestorMap(graph, startId, maxDepth) {
  var limit = maxDepth || KIN_MAX_DEPTH;
  var found = {};
  found[startId] = { depth: 0, side: 'self', path: [startId] };

  var frontier = [{ id: startId, depth: 0, side: 'self', path: [startId] }];

  while (frontier.length) {
    var next = [];
    for (var i = 0; i < frontier.length; i++) {
      var node = frontier[i];
      if (node.depth >= limit) continue;

      var links = graph.parentsOf[node.id] || [];
      for (var j = 0; j < links.length; j++) {
        var link = links[j];
        if (link.relation_type !== 'biological' && link.relation_type !== 'adoptive') continue;

        var side = node.depth === 0
          ? (link.parent_role === 'mother' ? 'maternal' : 'paternal')
          : node.side;

        var existing = found[link.parent_id];
        if (existing) {
          // Reachable two ways: record that the two sides converge, but keep
          // the shorter path. Cousin marriage makes this ordinary, not exotic.
          if (existing.side !== side && existing.side !== 'both') existing.side = 'both';
          if (existing.depth <= node.depth + 1) continue;
        }

        var entry = {
          depth: node.depth + 1,
          side: side,
          path: node.path.concat([link.parent_id])
        };
        found[link.parent_id] = entry;
        next.push({ id: link.parent_id, depth: entry.depth, side: side, path: entry.path });
      }
    }
    frontier = next;
  }
  return found;
}

/**
 * The closest ancestor shared by two people.
 *
 * Preference order: fewest total steps first, then the most balanced split.
 * Balance matters -- between a shared grandparent (2 up, 2 down: first cousins)
 * and a shared great-grandparent reached lopsidedly, the balanced one describes
 * the real relationship.
 */
function KIN_commonAncestor(egoMap, targetMap) {
  var best = null;
  for (var id in egoMap) {
    if (!Object.prototype.hasOwnProperty.call(egoMap, id)) continue;
    if (!targetMap[id]) continue;

    var up = egoMap[id].depth;
    var down = targetMap[id].depth;
    var total = up + down;
    var skew = Math.abs(up - down);

    if (!best || total < best.total || (total === best.total && skew < best.skew)) {
      best = {
        ancestorId: id,
        up: up,
        down: down,
        total: total,
        skew: skew,
        side: egoMap[id].side,
        egoPath: egoMap[id].path,
        targetPath: targetMap[id].path
      };
    }
  }
  return best;
}

/* ------------------------------------------------------------------ *
 * Relationship classification
 * ------------------------------------------------------------------ */

/**
 * Works out how `targetId` is related to `egoId`.
 *
 * Returns a language-neutral descriptor. Naming it is a separate step, because
 * the same structural fact is named differently in Malay, English and Arabic --
 * and Arabic in particular needs to know which side of the family the link runs
 * through, which is why `side` is carried all the way here.
 */
function KIN_relate(graph, egoId, targetId) {
  if (!egoId || !targetId) return { kind: 'unrelated' };
  if (egoId === targetId) return { kind: 'self' };

  var target = graph.people[targetId];
  if (!target) return { kind: 'unrelated' };

  // 1. Married to each other.
  var union = KIN_unionBetween(graph, egoId, targetId);
  if (union) {
    return {
      kind: 'spouse',
      gender: target.gender,
      unionStatus: union.status,
      unionOrder: union.order_index,
      target: targetId
    };
  }

  // 2. Related by blood or adoption.
  var egoMap = KIN_ancestorMap(graph, egoId);
  var targetMap = KIN_ancestorMap(graph, targetId);
  var lca = KIN_commonAncestor(egoMap, targetMap);

  if (lca) {
    return KIN_classifyBlood(graph, egoId, targetId, lca);
  }

  // 3. A step relationship. Checked before the general in-law search because a
  //    spouse's child is a step-child specifically, not merely somebody related
  //    to the person you married.
  var step = KIN_findStep(graph, egoId, targetId);
  if (step) return step;

  // 4. Related through a marriage.
  var inLaw = KIN_findInLaw(graph, egoId, targetId, egoMap, targetMap);
  if (inLaw) return inLaw;

  return { kind: 'unrelated', target: targetId, gender: target.gender };
}

function KIN_classifyBlood(graph, egoId, targetId, lca) {
  var target = graph.people[targetId];
  var up = lca.up;
  var down = lca.down;

  var base = {
    kind: 'blood',
    up: up,
    down: down,
    side: lca.side,
    gender: target.gender,
    ancestorId: lca.ancestorId,
    target: targetId
  };

  // Direct line down: child, grandchild, great-grandchild.
  if (up === 0) {
    base.type = 'descendant';
    base.generations = down;
    return base;
  }

  // Direct line up: parent, grandparent, great-grandparent.
  if (down === 0) {
    base.type = 'ancestor';
    base.generations = up;
    return base;
  }

  // Siblings.
  if (up === 1 && down === 1) {
    base.type = 'sibling';
    var shared = KIN_sharedParents(graph, egoId, targetId);
    base.full = shared.length >= 2;
    base.halfVia = shared.length === 1 ? shared[0].parent_role : null;
    base.elder = KIN_isElder(graph, targetId, egoId);
    return base;
  }

  // A sibling of an ancestor: uncle, aunt, great-uncle.
  if (down === 1) {
    base.type = 'auncle';
    base.generations = up - 1;
    // The Malay title depends on where this person ranks among their own
    // siblings, so the ranking is resolved here rather than at naming time.
    base.birthOrder = KIN_birthOrder(graph, targetId);
    base.siblingCount = KIN_siblingCount(graph, targetId);
    base.linkParentId = lca.egoPath[up - 1];
    return base;
  }

  // A descendant of a sibling: nephew, niece, great-nephew.
  if (up === 1) {
    base.type = 'nibling';
    base.generations = down - 1;
    base.linkSiblingId = lca.targetPath[down - 1];
    return base;
  }

  // Cousins. Degree counts shared-ancestor distance, removal counts the
  // generation gap between the two branches.
  base.type = 'cousin';
  base.degree = Math.min(up, down) - 1;
  base.removed = Math.abs(up - down);
  base.elderBranch = up > down;
  // Which uncle or aunt this cousin descends from -- Arabic names cousins after
  // that person ('ibn al-khal' is specifically a maternal uncle's son).
  base.linkAuncleId = lca.targetPath[down - 1];
  base.linkAuncle = graph.people[base.linkAuncleId] || null;
  return base;
}

/* ------------------------------------------------------------------ *
 * Relationships created by marriage
 * ------------------------------------------------------------------ */

function KIN_findInLaw(graph, egoId, targetId, egoMap, targetMap) {
  var target = graph.people[targetId];

  // The target is married to a blood relative of mine.
  var targetSpouses = KIN_spousesOf(graph, targetId);
  for (var i = 0; i < targetSpouses.length; i++) {
    var spouseId = targetSpouses[i].personId;
    var viaMap = KIN_ancestorMap(graph, spouseId);
    var lca = KIN_commonAncestor(egoMap, viaMap);
    if (lca) {
      var viaRel = KIN_classifyBlood(graph, egoId, spouseId, lca);
      return {
        kind: 'in_law',
        direction: 'spouse_of_relative',
        gender: target.gender,
        via: viaRel,
        viaPersonId: spouseId,
        target: targetId
      };
    }
  }

  // The target is a blood relative of the person I am married to.
  var mySpouses = KIN_spousesOf(graph, egoId);
  for (var k = 0; k < mySpouses.length; k++) {
    var mySpouseId = mySpouses[k].personId;
    var spouseMap = KIN_ancestorMap(graph, mySpouseId);
    var lca2 = KIN_commonAncestor(spouseMap, targetMap);
    if (lca2) {
      var rel2 = KIN_classifyBlood(graph, mySpouseId, targetId, lca2);
      return {
        kind: 'in_law',
        direction: 'relative_of_spouse',
        gender: target.gender,
        via: rel2,
        viaPersonId: mySpouseId,
        target: targetId
      };
    }
  }

  // The target is married to a relative of the person I am married to. Two men
  // married to two sisters are biras to each other -- a relationship Malay
  // names, English cannot, and which the Salim family's own trip manifest had
  // to leave blank because a flat list has nowhere to put it.
  for (var m = 0; m < mySpouses.length; m++) {
    var mySpouseMap = KIN_ancestorMap(graph, mySpouses[m].personId);
    for (var t = 0; t < targetSpouses.length; t++) {
      if (targetSpouses[t].personId === egoId) continue;
      var theirMap = KIN_ancestorMap(graph, targetSpouses[t].personId);
      var lca3 = KIN_commonAncestor(mySpouseMap, theirMap);
      if (lca3) {
        return {
          kind: 'in_law',
          direction: 'spouse_of_spouses_relative',
          gender: target.gender,
          via: KIN_classifyBlood(graph, mySpouses[m].personId,
                                 targetSpouses[t].personId, lca3),
          viaPersonId: targetSpouses[t].personId,
          target: targetId
        };
      }
    }
  }

  // The target is a parent of my child's spouse. Malay names this pair
  // relationship 'besan'; English has no word for it at all.
  var myChildren = KIN_childrenOf(graph, egoId);
  for (var c = 0; c < myChildren.length; c++) {
    var childSpouses = KIN_spousesOf(graph, myChildren[c]);
    for (var s = 0; s < childSpouses.length; s++) {
      var inLawParents = KIN_parentsOf(graph, childSpouses[s].personId);
      for (var p = 0; p < inLawParents.length; p++) {
        if (inLawParents[p] === targetId) {
          return {
            kind: 'in_law',
            direction: 'co_parent_in_law',
            gender: target.gender,
            target: targetId
          };
        }
      }
    }
  }

  return null;
}

function KIN_findStep(graph, egoId, targetId) {
  var target = graph.people[targetId];

  // Married to one of my parents, but not a parent of mine.
  var myParents = KIN_parentsOf(graph, egoId);
  for (var i = 0; i < myParents.length; i++) {
    var spouses = KIN_spousesOf(graph, myParents[i]);
    for (var j = 0; j < spouses.length; j++) {
      if (spouses[j].personId === targetId) {
        return { kind: 'step', type: 'parent', gender: target.gender, target: targetId };
      }
    }
  }

  // A child of my spouse, but not a child of mine.
  var mySpouses = KIN_spousesOf(graph, egoId);
  var myChildren = KIN_childrenOf(graph, egoId);
  for (var k = 0; k < mySpouses.length; k++) {
    var theirChildren = KIN_childrenOf(graph, mySpouses[k].personId);
    for (var m = 0; m < theirChildren.length; m++) {
      if (theirChildren[m] === targetId && myChildren.indexOf(targetId) === -1) {
        return { kind: 'step', type: 'child', gender: target.gender, target: targetId };
      }
    }
  }

  // A child of my step-parent, sharing no parent with me.
  for (var n = 0; n < myParents.length; n++) {
    var parentSpouses = KIN_spousesOf(graph, myParents[n]);
    for (var q = 0; q < parentSpouses.length; q++) {
      var stepParentId = parentSpouses[q].personId;
      if (myParents.indexOf(stepParentId) !== -1) continue;
      var stepSibs = KIN_childrenOf(graph, stepParentId);
      if (stepSibs.indexOf(targetId) !== -1) {
        return {
          kind: 'step',
          type: 'sibling',
          gender: target.gender,
          elder: KIN_isElder(graph, targetId, egoId),
          target: targetId
        };
      }
    }
  }

  return null;
}

/* ------------------------------------------------------------------ *
 * Graph helpers
 * ------------------------------------------------------------------ */

function KIN_parentsOf(graph, personId) {
  var links = graph.parentsOf[personId] || [];
  var out = [];
  for (var i = 0; i < links.length; i++) {
    if (links[i].relation_type === 'biological' || links[i].relation_type === 'adoptive') {
      out.push(links[i].parent_id);
    }
  }
  return out;
}

function KIN_childrenOf(graph, personId) {
  var links = graph.childrenOf[personId] || [];
  var out = [];
  for (var i = 0; i < links.length; i++) {
    if (links[i].relation_type === 'biological' || links[i].relation_type === 'adoptive') {
      out.push(links[i].child_id);
    }
  }
  return out;
}

function KIN_sharedParents(graph, aId, bId) {
  var aLinks = graph.parentsOf[aId] || [];
  var bParents = KIN_parentsOf(graph, bId);
  var shared = [];
  for (var i = 0; i < aLinks.length; i++) {
    if (bParents.indexOf(aLinks[i].parent_id) !== -1) shared.push(aLinks[i]);
  }
  return shared;
}

function KIN_spousesOf(graph, personId) {
  var unions = graph.unionsOf[personId] || [];
  var out = [];
  for (var i = 0; i < unions.length; i++) {
    var u = unions[i];
    var other = u.partner_a_id === personId ? u.partner_b_id : u.partner_a_id;
    if (other) out.push({ personId: other, union: u, status: u.status });
  }
  return out;
}

function KIN_unionBetween(graph, aId, bId) {
  var unions = graph.unionsOf[aId] || [];
  for (var i = 0; i < unions.length; i++) {
    var u = unions[i];
    if (u.partner_a_id === bId || u.partner_b_id === bId) return u;
  }
  return null;
}

/** Full siblings, plus half siblings, ordered by birth. */
function KIN_siblingsOf(graph, personId) {
  var parents = KIN_parentsOf(graph, personId);
  var seen = {};
  var out = [];
  for (var i = 0; i < parents.length; i++) {
    var kids = KIN_childrenOf(graph, parents[i]);
    for (var j = 0; j < kids.length; j++) {
      if (kids[j] !== personId && !seen[kids[j]]) {
        seen[kids[j]] = true;
        out.push(kids[j]);
      }
    }
  }
  return out;
}

/**
 * Where a person ranks among their siblings, counting from 1.
 *
 * This is what decides whether an uncle is Pak Long or Pak Su, and it is the one
 * piece of the Malay title system that the tree shape cannot supply. Recorded
 * order wins; otherwise it is inferred from birth dates. For a grandparents'
 * generation, where dates are often unknown, this returns null and the app falls
 * back to the generic Pak Cik / Mak Cik.
 */
function KIN_birthOrder(graph, personId) {
  var person = graph.people[personId];
  if (!person) return null;
  if (person.birth_order_source === 'manual' && person.birth_order) {
    return Number(person.birth_order);
  }

  var group = KIN_siblingsOf(graph, personId).concat([personId]);
  var dated = [];
  for (var i = 0; i < group.length; i++) {
    var p = graph.people[group[i]];
    if (!p) continue;
    var order = p.birth_order ? Number(p.birth_order) : null;
    var date = p.birth_date ? String(p.birth_date) : null;
    if (!order && !date) return null; // One unknown sibling makes the whole ranking unsafe.
    dated.push({ id: group[i], order: order, date: date });
  }

  dated.sort(function (a, b) {
    if (a.order && b.order) return a.order - b.order;
    if (a.order) return -1;
    if (b.order) return 1;
    return a.date < b.date ? -1 : (a.date > b.date ? 1 : 0);
  });

  for (var k = 0; k < dated.length; k++) {
    if (dated[k].id === personId) return k + 1;
  }
  return null;
}

function KIN_siblingCount(graph, personId) {
  return KIN_siblingsOf(graph, personId).length + 1;
}

/** True when `aId` was born before `bId`. Null when it cannot be determined. */
function KIN_isElder(graph, aId, bId) {
  var a = graph.people[aId];
  var b = graph.people[bId];
  if (!a || !b) return null;
  if (a.birth_order && b.birth_order) return Number(a.birth_order) < Number(b.birth_order);
  if (a.birth_date && b.birth_date) return String(a.birth_date) < String(b.birth_date);
  return null;
}

if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    KIN_ancestorMap: KIN_ancestorMap,
    KIN_commonAncestor: KIN_commonAncestor,
    KIN_relate: KIN_relate,
    KIN_birthOrder: KIN_birthOrder,
    KIN_siblingsOf: KIN_siblingsOf,
    KIN_spousesOf: KIN_spousesOf
  };
}

/* ================================================================== *
 * 07_Titles.gs                                                   *
 * ================================================================== */

/**
 * Naming the relationship.
 *
 * KIN_relate() works out the structure; this file puts a word to it in Malay,
 * English or Arabic. The three languages do not carve up the family the same
 * way, which is exactly why naming is separated from classification:
 *
 *   - Malay grades a parent's siblings by BIRTH ORDER. Pak Long is the eldest
 *     uncle, Pak Su the youngest, and the word changes with his rank among his
 *     own siblings -- not with his relationship to you.
 *   - Arabic grades them by SIDE. Your father's brother is 'Amm, your mother's
 *     brother is Khal, and there is no word that covers both.
 *   - English grades them by neither. Both are "uncle".
 *
 * A single stored fact therefore yields "Pak Su", "Khal" and "Uncle" depending
 * only on who is reading.
 */

/* Malay birth-order titles, eldest first. The family's own sequence overrides
 * this from Settings; the youngest is always 'Su' regardless of the list. */
var TTL_DEFAULT_BIRTH_ORDER = ['Long', 'Ngah', 'Alang', 'Anjang', 'Andak', 'Uda', 'Uteh'];

var TTL_MS = {
  ancestor: ['', 'Ayah', 'Atuk', 'Moyang', 'Datuk Moyang'],
  ancestorF: ['', 'Ibu', 'Nenek', 'Moyang', 'Nenek Moyang'],
  descendant: ['', 'Anak', 'Cucu', 'Cicit', 'Piut', 'Anggah'],
  cousinDegree: ['', 'Sepupu', 'Dua Pupu', 'Tiga Pupu', 'Empat Pupu']
};

var TTL_EN = {
  ordinal: ['', 'First', 'Second', 'Third', 'Fourth', 'Fifth', 'Sixth'],
  removed: ['', 'once removed', 'twice removed', 'three times removed']
};

/**
 * The public entry point: what does `egoId` call `targetId`?
 *
 * Returns { label, script, code, source, detail }. `script` carries Arabic in
 * its own alphabet where relevant; `source` is 'custom' when the family's own
 * name for someone has overridden the computed one.
 */
function TTL_title(graph, egoId, targetId, lang, settings) {
  lang = lang || 'ms';

  var custom = TTL_customTitle(graph, egoId, targetId, lang);
  if (custom) {
    return { label: custom, script: '', code: 'custom', source: 'custom', detail: null };
  }

  var rel = KIN_relate(graph, egoId, targetId);
  var named = TTL_name(graph, rel, lang, settings);
  named.source = 'computed';
  named.detail = rel;
  return named;
}

/**
 * A family's own name for someone beats anything an algorithm can work out.
 * A title recorded against GLOBAL applies to every viewer, which covers the
 * common case of one person the whole family calls by a particular name.
 */
function TTL_customTitle(graph, egoId, targetId, lang) {
  var rows = graph.customTitles || [];
  var globalHit = null;
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    if (row.to_person_id !== targetId) continue;
    if (row.lang !== '*' && row.lang !== lang) continue;
    if (row.from_person_id === egoId) return row.custom_label;
    if (row.from_person_id === 'GLOBAL') globalHit = row.custom_label;
  }
  return globalHit;
}

function TTL_name(graph, rel, lang, settings) {
  if (lang === 'en') return TTL_english(graph, rel);
  if (lang === 'ar') return TTL_arabic(graph, rel);
  return TTL_malay(graph, rel, settings);
}

function TTL_wrap(label, script, code) {
  return { label: label, script: script || '', code: code || '' };
}

/* ------------------------------------------------------------------ *
 * Malay
 * ------------------------------------------------------------------ */

function TTL_malay(graph, rel, settings) {
  var m = rel.gender === 'F' ? 'F' : (rel.gender === 'M' ? 'M' : 'U');

  switch (rel.kind) {
    case 'self':
      return TTL_wrap('Saya', '', 'self');

    case 'spouse':
      if (rel.unionStatus === 'divorced') return TTL_wrap(m === 'F' ? 'Bekas Isteri' : 'Bekas Suami', '', 'ex_spouse');
      if (rel.unionStatus === 'widowed') return TTL_wrap(m === 'F' ? 'Arwah Isteri' : 'Arwah Suami', '', 'late_spouse');
      return TTL_wrap(m === 'F' ? 'Isteri' : 'Suami', '', 'spouse');

    case 'blood':
      return TTL_malayBlood(graph, rel, settings);

    case 'in_law':
      return TTL_malayInLaw(graph, rel, settings);

    case 'step':
      if (rel.type === 'parent') return TTL_wrap(m === 'F' ? 'Ibu Tiri' : 'Ayah Tiri', '', 'step_parent');
      if (rel.type === 'child') return TTL_wrap(m === 'F' ? 'Anak Perempuan Tiri' : 'Anak Lelaki Tiri', '', 'step_child');
      if (rel.type === 'sibling') {
        if (rel.elder === true) return TTL_wrap(m === 'F' ? 'Kakak Tiri' : 'Abang Tiri', '', 'step_sibling');
        if (rel.elder === false) return TTL_wrap('Adik Tiri', '', 'step_sibling');
        return TTL_wrap('Adik-beradik Tiri', '', 'step_sibling');
      }
      return TTL_wrap('Keluarga Tiri', '', 'step');

    default:
      return TTL_wrap('Ahli Keluarga', '', 'unrelated');
  }
}

function TTL_malayBlood(graph, rel, settings) {
  var isF = rel.gender === 'F';
  var g = rel.generations;

  if (rel.type === 'ancestor') {
    var up = isF ? TTL_MS.ancestorF : TTL_MS.ancestor;
    if (g < up.length) return TTL_wrap(up[g], '', 'ancestor_' + g);
    return TTL_wrap('Moyang ke-' + (g - 1), '', 'ancestor_' + g);
  }

  if (rel.type === 'descendant') {
    if (g < TTL_MS.descendant.length) {
      var word = TTL_MS.descendant[g];
      if (g === 1) word = isF ? 'Anak Perempuan' : (rel.gender === 'M' ? 'Anak Lelaki' : 'Anak');
      return TTL_wrap(word, '', 'descendant_' + g);
    }
    return TTL_wrap('Keturunan ke-' + g, '', 'descendant_' + g);
  }

  if (rel.type === 'sibling') {
    var suffix = '';
    if (!rel.full) suffix = rel.halfVia === 'mother' ? ' Seibu' : ' Sebapa';
    if (rel.elder === true) return TTL_wrap((isF ? 'Kakak' : 'Abang') + suffix, '', 'sibling_elder');
    if (rel.elder === false) return TTL_wrap('Adik' + suffix, '', 'sibling_younger');
    return TTL_wrap('Adik-beradik' + suffix, '', 'sibling');
  }

  if (rel.type === 'auncle') {
    if (rel.generations === 1) {
      return TTL_wrap(TTL_malayAuncle(rel, isF, settings), '', 'auncle_1');
    }
    if (rel.generations === 2) return TTL_wrap(isF ? 'Nenek Saudara' : 'Atuk Saudara', '', 'auncle_2');
    return TTL_wrap(isF ? 'Moyang Saudara' : 'Moyang Saudara', '', 'auncle_' + rel.generations);
  }

  if (rel.type === 'nibling') {
    if (rel.generations === 1) return TTL_wrap('Anak Saudara', '', 'nibling_1');
    if (rel.generations === 2) return TTL_wrap('Cucu Saudara', '', 'nibling_2');
    return TTL_wrap('Cicit Saudara', '', 'nibling_' + rel.generations);
  }

  if (rel.type === 'cousin') {
    var base = rel.degree < TTL_MS.cousinDegree.length
      ? TTL_MS.cousinDegree[rel.degree]
      : rel.degree + ' Pupu';
    if (!rel.removed) return TTL_wrap(base, '', 'cousin_' + rel.degree);
    if (!rel.elderBranch) {
      // The cousin's child, or grandchild.
      var down = ['', 'Anak ', 'Cucu ', 'Cicit '][Math.min(rel.removed, 3)];
      return TTL_wrap(down + base, '', 'cousin_' + rel.degree + '_r' + rel.removed);
    }
    var upWord = rel.removed === 1 ? 'Ibu Bapa' : 'Atuk Nenek';
    return TTL_wrap(base + ' ' + upWord, '', 'cousin_' + rel.degree + '_r' + rel.removed);
  }

  return TTL_wrap('Saudara', '', 'blood');
}

/**
 * Pak Long, Mak Ngah, Pak Su.
 *
 * The rank is the person's own position among their siblings, so the eldest of
 * five brothers is Pak Long to every one of his nieces and nephews. The youngest
 * is always Su whatever the list says. Where the family has not recorded enough
 * birth dates to rank the generation, this falls back to the generic Pak Cik /
 * Mak Cik rather than guessing -- calling the eldest uncle Pak Su is worse than
 * calling him Pak Cik.
 */
function TTL_malayAuncle(rel, isF, settings) {
  var prefix = isF ? 'Mak' : 'Pak';
  var order = rel.birthOrder;
  var count = rel.siblingCount;

  if (!order || !count) return prefix + ' Cik';
  if (count > 1 && order === count) return prefix + ' Su';

  var list = TTL_birthOrderList(settings);
  if (order - 1 < list.length) return prefix + ' ' + list[order - 1];
  return prefix + ' Cik';
}

function TTL_birthOrderList(settings) {
  if (settings && settings.birth_order_titles) {
    var parts = String(settings.birth_order_titles).split(',');
    var out = [];
    for (var i = 0; i < parts.length; i++) {
      var trimmed = parts[i].replace(/^\s+|\s+$/g, '');
      if (trimmed) out.push(trimmed);
    }
    if (out.length) return out;
  }
  return TTL_DEFAULT_BIRTH_ORDER;
}

function TTL_malayInLaw(graph, rel, settings) {
  var isF = rel.gender === 'F';
  var via = rel.via;

  if (rel.direction === 'co_parent_in_law') return TTL_wrap('Besan', '', 'besan');

  if (rel.direction === 'relative_of_spouse' && via) {
    if (via.type === 'ancestor' && via.generations === 1) {
      return TTL_wrap(isF ? 'Ibu Mertua' : 'Bapa Mertua', '', 'parent_in_law');
    }
    if (via.type === 'ancestor' && via.generations === 2) {
      return TTL_wrap(isF ? 'Nenek Mertua' : 'Atuk Mertua', '', 'grandparent_in_law');
    }
    if (via.type === 'sibling') {
      if (via.elder === true) return TTL_wrap(isF ? 'Kakak Ipar' : 'Abang Ipar', '', 'sibling_in_law');
      if (via.elder === false) return TTL_wrap('Adik Ipar', '', 'sibling_in_law');
      return TTL_wrap('Ipar', '', 'sibling_in_law');
    }
    if (via.type === 'auncle' && via.generations === 1) {
      // Your spouse's uncle keeps his own birth-order title.
      return TTL_wrap(TTL_malayAuncle(via, isF, settings) + ' (sebelah pasangan)', '', 'auncle_in_law');
    }
    if (via.type === 'nibling') {
      // Your spouse's nephew is your nephew. Malay does not mark the distinction.
      return TTL_wrap(via.generations === 1 ? 'Anak Saudara' : 'Cucu Saudara', '', 'nibling_in_law');
    }
    if (via.type === 'descendant') {
      return TTL_wrap(isF ? 'Anak Perempuan Tiri' : 'Anak Lelaki Tiri', '', 'step_child');
    }
    if (via.type === 'cousin') return TTL_wrap('Sepupu Ipar', '', 'cousin_in_law');
    return TTL_wrap('Keluarga Mertua', '', 'in_law');
  }

  if (rel.direction === 'spouse_of_spouses_relative' && via) {
    // Married to your spouse's sibling.
    if (via.type === 'sibling') return TTL_wrap('Biras', '', 'biras');
    if (via.type === 'cousin') return TTL_wrap('Biras Sepupu', '', 'biras');
    if (via.type === 'auncle') return TTL_wrap(TTL_malayAuncle(via, isF, settings), '', 'auncle_by_marriage');
    return TTL_wrap('Keluarga Semenda', '', 'in_law');
  }

  if (rel.direction === 'spouse_of_relative' && via) {
    if (via.type === 'descendant' && via.generations === 1) {
      return TTL_wrap('Menantu', '', 'child_in_law');
    }
    if (via.type === 'sibling') {
      if (via.elder === true) return TTL_wrap(isF ? 'Kakak Ipar' : 'Abang Ipar', '', 'sibling_in_law');
      if (via.elder === false) return TTL_wrap('Adik Ipar', '', 'sibling_in_law');
      return TTL_wrap('Ipar', '', 'sibling_in_law');
    }
    if (via.type === 'auncle' && via.generations === 1) {
      // The wife of Pak Long is Mak Long. The title follows the marriage.
      return TTL_wrap(TTL_malayAuncle(via, isF, settings), '', 'auncle_by_marriage');
    }
    if (via.type === 'cousin') return TTL_wrap('Ipar Sepupu', '', 'cousin_in_law');
    if (via.type === 'nibling') return TTL_wrap('Menantu Saudara', '', 'nibling_in_law');
    return TTL_wrap('Keluarga Semenda', '', 'in_law');
  }

  return TTL_wrap('Keluarga Semenda', '', 'in_law');
}

/* ------------------------------------------------------------------ *
 * English
 * ------------------------------------------------------------------ */

function TTL_english(graph, rel) {
  var isF = rel.gender === 'F';

  switch (rel.kind) {
    case 'self': return TTL_wrap('You', '', 'self');
    case 'spouse':
      if (rel.unionStatus === 'divorced') return TTL_wrap(isF ? 'Ex-wife' : 'Ex-husband', '', 'ex_spouse');
      if (rel.unionStatus === 'widowed') return TTL_wrap(isF ? 'Late wife' : 'Late husband', '', 'late_spouse');
      return TTL_wrap(isF ? 'Wife' : 'Husband', '', 'spouse');
    case 'blood': return TTL_englishBlood(rel);
    case 'in_law': return TTL_englishInLaw(rel);
    case 'step':
      if (rel.type === 'parent') return TTL_wrap(isF ? 'Stepmother' : 'Stepfather', '', 'step_parent');
      if (rel.type === 'child') return TTL_wrap(isF ? 'Stepdaughter' : 'Stepson', '', 'step_child');
      if (rel.type === 'sibling') return TTL_wrap(isF ? 'Stepsister' : 'Stepbrother', '', 'step_sibling');
      return TTL_wrap('Step-relative', '', 'step');
    default: return TTL_wrap('Relative', '', 'unrelated');
  }
}

function TTL_englishBlood(rel) {
  var isF = rel.gender === 'F';
  var g = rel.generations;

  if (rel.type === 'ancestor') {
    if (g === 1) return TTL_wrap(isF ? 'Mother' : 'Father', '', 'ancestor_1');
    var base = isF ? 'Grandmother' : 'Grandfather';
    return TTL_wrap(TTL_prefixGreat(g - 2, base), '', 'ancestor_' + g);
  }

  if (rel.type === 'descendant') {
    if (g === 1) return TTL_wrap(isF ? 'Daughter' : 'Son', '', 'descendant_1');
    var d = isF ? 'Granddaughter' : 'Grandson';
    return TTL_wrap(TTL_prefixGreat(g - 2, d), '', 'descendant_' + g);
  }

  if (rel.type === 'sibling') {
    var word = isF ? 'Sister' : 'Brother';
    if (!rel.full) return TTL_wrap('Half-' + word.toLowerCase(), '', 'half_sibling');
    if (rel.elder === true) return TTL_wrap('Older ' + word.toLowerCase(), '', 'sibling_elder');
    if (rel.elder === false) return TTL_wrap('Younger ' + word.toLowerCase(), '', 'sibling_younger');
    return TTL_wrap(word, '', 'sibling');
  }

  if (rel.type === 'auncle') {
    return TTL_wrap(TTL_prefixGreat(rel.generations - 1, isF ? 'Aunt' : 'Uncle'), '', 'auncle_' + rel.generations);
  }

  if (rel.type === 'nibling') {
    return TTL_wrap(TTL_prefixGreat(rel.generations - 1, isF ? 'Niece' : 'Nephew'), '', 'nibling_' + rel.generations);
  }

  if (rel.type === 'cousin') {
    var ord = rel.degree < TTL_EN.ordinal.length ? TTL_EN.ordinal[rel.degree] : rel.degree + 'th';
    var label = ord + ' cousin';
    if (rel.removed) {
      label += ' ' + (rel.removed < TTL_EN.removed.length
        ? TTL_EN.removed[rel.removed]
        : rel.removed + ' times removed');
    }
    return TTL_wrap(label, '', 'cousin_' + rel.degree + '_r' + rel.removed);
  }

  return TTL_wrap('Relative', '', 'blood');
}

function TTL_prefixGreat(greats, base) {
  if (greats <= 0) return base;
  var prefix = '';
  for (var i = 0; i < greats; i++) prefix += 'Great-';
  return prefix + base.toLowerCase();
}

function TTL_englishInLaw(rel) {
  var isF = rel.gender === 'F';
  var via = rel.via;

  if (rel.direction === 'co_parent_in_law') return TTL_wrap("Child's parent-in-law", '', 'besan');

  if (via && via.type === 'ancestor' && via.generations === 1 && rel.direction === 'relative_of_spouse') {
    return TTL_wrap(isF ? 'Mother-in-law' : 'Father-in-law', '', 'parent_in_law');
  }
  if (via && via.type === 'descendant' && via.generations === 1 && rel.direction === 'spouse_of_relative') {
    return TTL_wrap(isF ? 'Daughter-in-law' : 'Son-in-law', '', 'child_in_law');
  }
  if (via && via.type === 'sibling') {
    return TTL_wrap(isF ? 'Sister-in-law' : 'Brother-in-law', '', 'sibling_in_law');
  }
  if (via && via.type === 'auncle') {
    return TTL_wrap(isF ? 'Aunt by marriage' : 'Uncle by marriage', '', 'auncle_in_law');
  }
  if (via && via.type === 'nibling' && rel.direction === 'relative_of_spouse') {
    return TTL_wrap(isF ? 'Niece by marriage' : 'Nephew by marriage', '', 'nibling_in_law');
  }
  if (via && via.type === 'descendant' && rel.direction === 'relative_of_spouse') {
    return TTL_wrap(isF ? 'Stepdaughter' : 'Stepson', '', 'step_child');
  }
  if (rel.direction === 'spouse_of_spouses_relative') {
    // English has no word for this: the people married to your spouse's
    // siblings. Speakers reach for brother- or sister-in-law and leave the
    // distinction unsaid.
    return TTL_wrap(isF ? 'Sister-in-law' : 'Brother-in-law', '', 'biras');
  }
  return TTL_wrap('In-law', '', 'in_law');
}

/* ------------------------------------------------------------------ *
 * Arabic
 * ------------------------------------------------------------------ */

function TTL_arabic(graph, rel) {
  var isF = rel.gender === 'F';

  switch (rel.kind) {
    case 'self': return TTL_wrap('Ana', 'أنا', 'self');
    case 'spouse': return TTL_wrap(isF ? 'Zawjah' : 'Zawj', isF ? 'زوجة' : 'زوج', 'spouse');
    case 'blood': return TTL_arabicBlood(graph, rel);
    case 'in_law': return TTL_arabicInLaw(rel);
    case 'step':
      if (rel.type === 'parent') return TTL_wrap(isF ? "Zawjat al-Ab" : "Zawj al-Umm", isF ? 'زوجة الأب' : 'زوج الأم', 'step_parent');
      if (rel.type === 'child') return TTL_wrap(isF ? 'Rabibah' : 'Rabib', isF ? 'ربيبة' : 'ربيب', 'step_child');
      return TTL_wrap('Qarib bil-musaharah', 'قريب بالمصاهرة', 'step');
    default: return TTL_wrap('Qarib', 'قريب', 'unrelated');
  }
}

function TTL_arabicBlood(graph, rel) {
  var isF = rel.gender === 'F';
  var g = rel.generations;

  if (rel.type === 'ancestor') {
    if (g === 1) return TTL_wrap(isF ? 'Umm' : 'Ab', isF ? 'أم' : 'أب', 'ancestor_1');
    if (g === 2) return TTL_wrap(isF ? 'Jaddah' : 'Jadd', isF ? 'جدة' : 'جد', 'ancestor_2');
    return TTL_wrap((isF ? 'Jaddah' : 'Jadd') + " al-'ulya", isF ? 'جدة عليا' : 'جد أعلى', 'ancestor_' + g);
  }

  if (rel.type === 'descendant') {
    if (g === 1) return TTL_wrap(isF ? 'Bint' : 'Ibn', isF ? 'بنت' : 'ابن', 'descendant_1');
    if (g === 2) return TTL_wrap(isF ? 'Hafidah' : 'Hafid', isF ? 'حفيدة' : 'حفيد', 'descendant_2');
    return TTL_wrap((isF ? 'Bint al-Hafid' : 'Ibn al-Hafid'), isF ? 'بنت الحفيد' : 'ابن الحفيد', 'descendant_' + g);
  }

  if (rel.type === 'sibling') {
    return TTL_wrap(isF ? 'Ukht' : 'Akh', isF ? 'أخت' : 'أخ', 'sibling');
  }

  if (rel.type === 'auncle') {
    var maternal = rel.side === 'maternal';
    if (rel.generations === 1) {
      if (maternal) return TTL_wrap(isF ? 'Khalah' : 'Khal', isF ? 'خالة' : 'خال', 'auncle_1');
      return TTL_wrap(isF ? "'Ammah" : "'Amm", isF ? 'عمة' : 'عم', 'auncle_1');
    }
    if (maternal) return TTL_wrap(isF ? 'Khalat al-Ab' : 'Khal al-Ab', isF ? 'خالة الأب' : 'خال الأب', 'auncle_2');
    return TTL_wrap(isF ? "'Ammat al-Ab" : "'Amm al-Ab", isF ? 'عمة الأب' : 'عم الأب', 'auncle_2');
  }

  if (rel.type === 'nibling') {
    if (rel.generations >= 2) {
      return TTL_wrap(isF ? 'Hafidat al-Akh' : 'Hafid al-Akh',
                      isF ? 'حفيدة الأخ' : 'حفيد الأخ', 'nibling_' + rel.generations);
    }
    return TTL_wrap(isF ? 'Bint al-Akh' : 'Ibn al-Akh', isF ? 'بنت الأخ' : 'ابن الأخ', 'nibling_1');
  }

  if (rel.type === 'cousin') {
    return TTL_arabicCousin(rel, isF);
  }

  return TTL_wrap('Qarib', 'قريب', 'blood');
}

/**
 * Arabic names a cousin after the uncle or aunt they descend from, so the term
 * encodes both the side of the family and that linking person's gender. Four
 * distinct words where English has one.
 */
function TTL_arabicCousin(rel, isF) {
  var link = rel.linkAuncle;
  var maternal = rel.side === 'maternal';
  var linkIsF = link && link.gender === 'F';

  var parentWord, parentScript;
  if (maternal) {
    parentWord = linkIsF ? 'al-Khalah' : 'al-Khal';
    parentScript = linkIsF ? 'الخالة' : 'الخال';
  } else {
    parentWord = linkIsF ? "al-'Ammah" : "al-'Amm";
    parentScript = linkIsF ? 'العمة' : 'العم';
  }

  var self = isF ? 'Bint' : 'Ibn';
  var selfScript = isF ? 'بنت' : 'ابن';

  var label = self + ' ' + parentWord;
  var script = selfScript + ' ' + parentScript;
  if (rel.degree > 1) label += ' (darajah ' + rel.degree + ')';
  return TTL_wrap(label, script, 'cousin_' + rel.degree + '_r' + rel.removed);
}

function TTL_arabicInLaw(rel) {
  var isF = rel.gender === 'F';
  var via = rel.via;

  if (rel.direction === 'co_parent_in_law') return TTL_wrap('Nasib', 'نسيب', 'besan');

  if (via && via.type === 'ancestor' && via.generations === 1 && rel.direction === 'relative_of_spouse') {
    return TTL_wrap(isF ? 'Hamah' : 'Ham', isF ? 'حماة' : 'حم', 'parent_in_law');
  }
  if (via && via.type === 'descendant' && via.generations === 1 && rel.direction === 'spouse_of_relative') {
    return TTL_wrap(isF ? 'Kannah' : 'Sihr', isF ? 'كنة' : 'صهر', 'child_in_law');
  }
  if (via && via.type === 'sibling' && rel.direction !== 'spouse_of_spouses_relative') {
    return TTL_wrap(isF ? 'Salifah' : 'Sihr', isF ? 'سليفة' : 'صهر', 'sibling_in_law');
  }
  if (rel.direction === 'spouse_of_spouses_relative') {
    return TTL_wrap(isF ? 'Silfah' : 'Silf', isF ? 'سلفة' : 'سلف', 'biras');
  }
  if (via && via.type === 'nibling') {
    return TTL_wrap(isF ? 'Bint al-Akh' : 'Ibn al-Akh', isF ? 'بنت الأخ' : 'ابن الأخ', 'nibling_in_law');
  }
  return TTL_wrap('Qarib bil-musaharah', 'قريب بالمصاهرة', 'in_law');
}

if (typeof module !== 'undefined' && module.exports) {
  module.exports = { TTL_title: TTL_title, TTL_name: TTL_name };
}

/* ================================================================== *
 * 08_Matching.gs                                                 *
 * ================================================================== */

/**
 * Duplicate detection.
 *
 * In any crowd-sourced family tree the same person gets entered twice by two
 * different relatives, and the tree quietly becomes wrong: the two records never
 * link up, so half the family appears unrelated to the other half. Catching this
 * at entry time matters far more than cleaning it up later, because by then
 * other people have already attached children to the wrong copy.
 *
 * The single most useful signal costs nothing and most systems throw it away:
 * a Malay name states its owner's father. "Ahmad bin Ismail" is Ahmad, son of
 * Ismail. When someone types that name and the tree already holds an Ahmad whose
 * recorded father is called Ismail, that is not a coincidence.
 */

/* Spelling variants that are the same name. Malay transliterations of Arabic
 * names vary by generation, by registrar and by personal preference, so string
 * similarity alone treats Mohd, Muhammad and Mohamed as three different people. */
var MTC_ALIASES = {
  mohd: 'muhammad', muhd: 'muhammad', mohamad: 'muhammad', mohamed: 'muhammad',
  mohammad: 'muhammad', mohammed: 'muhammad', md: 'muhammad', mhd: 'muhammad',
  abd: 'abdul', abdoul: 'abdul', abdull: 'abdul',
  nor: 'nur', noor: 'nur', nurul: 'nur',
  ahmed: 'ahmad', achmad: 'ahmad',
  yusuf: 'yusof', yusoff: 'yusof', joseph: 'yusof',
  ismael: 'ismail', ibrahiem: 'ibrahim',
  fatima: 'fatimah', fatma: 'fatimah',
  aisyah: 'aisha', ayesha: 'aisha', aishah: 'aisha',
  zainab: 'zainab', zaynab: 'zainab',
  khadija: 'khadijah', hadijah: 'khadijah',
  sulaiman: 'sulaiman', suleiman: 'sulaiman', solomon: 'sulaiman',
  osman: 'osman', othman: 'osman', usman: 'osman',
  hamzah: 'hamza', hamsah: 'hamza'
};

/* Titles and honorifics carry no identity information. */
var MTC_HONORIFICS = ['haji', 'hajjah', 'hj', 'hjh', 'dato', 'datuk', 'dr', 'ustaz',
                      'ustazah', 'tuan', 'puan', 'encik', 'cik', 'syed', 'sharifah'];

/* The words that introduce a patronymic, and what they imply about gender. */
var MTC_PATRONYM_MARKERS = [
  { words: ['bin', 'b', 'ibn'], type: 'bin', gender: 'M' },
  { words: ['binti', 'binte', 'bt', 'bte'], type: 'binti', gender: 'F' },
  { words: ['a/l', 'al', 's/o'], type: 'a/l', gender: 'M' },
  { words: ['a/p', 'd/o'], type: 'a/p', gender: 'F' }
];

/* ------------------------------------------------------------------ *
 * Name parsing
 * ------------------------------------------------------------------ */

function MTC_normalise(text) {
  if (!text) return '';
  var lower = String(text).toLowerCase();
  var letters = lower.replace(/[^a-z0-9/\s]/g, ' ');
  var single = letters.replace(/\s+/g, ' ');
  return single.replace(/^\s+|\s+$/g, '');
}

function MTC_canonicalToken(token) {
  return MTC_ALIASES[token] || token;
}

/**
 * Splits a name into the person's own names and their father's.
 *
 * Returns { own, patronym, type, genderHint }. `own` and `patronym` are arrays
 * of canonical tokens with honorifics removed, so "Hj. Mohd Ahmad bin Ismail"
 * yields own ['muhammad','ahmad'], patronym ['ismail'], genderHint 'M'.
 */
function MTC_parseName(fullName) {
  var tokens = MTC_normalise(fullName).split(' ');
  var own = [];
  var patronym = [];
  var type = 'none';
  var genderHint = null;
  var afterMarker = false;

  for (var i = 0; i < tokens.length; i++) {
    var token = tokens[i];
    if (!token) continue;

    if (!afterMarker) {
      var marker = MTC_matchMarker(token, tokens[i + 1]);
      if (marker) {
        // A lone "b" is only a marker when a name follows it.
        afterMarker = true;
        type = marker.type;
        genderHint = marker.gender;
        continue;
      }
    }

    if (MTC_HONORIFICS.indexOf(token) !== -1) continue;

    if (afterMarker) patronym.push(MTC_canonicalToken(token));
    else own.push(MTC_canonicalToken(token));
  }

  return { own: own, patronym: patronym, type: type, genderHint: genderHint };
}

function MTC_matchMarker(token, nextToken) {
  for (var i = 0; i < MTC_PATRONYM_MARKERS.length; i++) {
    var marker = MTC_PATRONYM_MARKERS[i];
    if (marker.words.indexOf(token) !== -1) {
      // "b" and "al" appear inside ordinary names too, so require a following word.
      if ((token === 'b' || token === 'al') && !nextToken) return null;
      return marker;
    }
  }
  return null;
}

/* ------------------------------------------------------------------ *
 * String similarity
 * ------------------------------------------------------------------ */

/** Jaro-Winkler, which handles the transpositions and dropped letters that
 *  hand-typed names are full of, and rewards a matching prefix. */
function MTC_jaroWinkler(a, b) {
  if (!a || !b) return 0;
  if (a === b) return 1;

  var matchWindow = Math.max(0, Math.floor(Math.max(a.length, b.length) / 2) - 1);
  var aFlags = [];
  var bFlags = [];
  var matches = 0;

  for (var i = 0; i < a.length; i++) {
    var start = Math.max(0, i - matchWindow);
    var end = Math.min(i + matchWindow + 1, b.length);
    for (var j = start; j < end; j++) {
      if (bFlags[j] || a[i] !== b[j]) continue;
      aFlags[i] = true;
      bFlags[j] = true;
      matches++;
      break;
    }
  }
  if (!matches) return 0;

  var transpositions = 0;
  var k = 0;
  for (var m = 0; m < a.length; m++) {
    if (!aFlags[m]) continue;
    while (!bFlags[k]) k++;
    if (a[m] !== b[k]) transpositions++;
    k++;
  }
  transpositions = transpositions / 2;

  var jaro = (matches / a.length + matches / b.length + (matches - transpositions) / matches) / 3;

  var prefix = 0;
  for (var p = 0; p < Math.min(4, a.length, b.length); p++) {
    if (a[p] === b[p]) prefix++;
    else break;
  }
  return jaro + prefix * 0.1 * (1 - jaro);
}

/**
 * Similarity between two name tokens, corrected for length.
 *
 * Jaro-Winkler on its own rates 'rahim' against 'ibrahim' at 0.91 and 'ali'
 * against 'khalid' at 0.83, because a short string contained in a longer one
 * scores highly. Malay given names are full of such pairs and treating them as
 * matches merges unrelated families, so similarity is scaled by how far apart
 * the two tokens are in length. Identical tokens are unaffected.
 */
function MTC_tokenScore(a, b) {
  if (a === b) return 1;
  var raw = MTC_jaroWinkler(a, b);
  var ratio = Math.min(a.length, b.length) / Math.max(a.length, b.length);
  return raw * (0.5 + 0.5 * ratio);
}

function MTC_directionalSimilarity(tokensA, tokensB) {
  if (!tokensA.length || !tokensB.length) return 0;
  var total = 0;
  for (var i = 0; i < tokensA.length; i++) {
    var best = 0;
    for (var j = 0; j < tokensB.length; j++) {
      var score = MTC_tokenScore(tokensA[i], tokensB[j]);
      if (score > best) best = score;
    }
    total += best;
  }
  return total / tokensA.length;
}

/**
 * Agreement between two lists of name tokens, in whichever direction is
 * stronger. People routinely enter a relative under a shorter form of their
 * name -- "Ahmad" for "Ahmad Faizal" -- and the extra token should not count
 * against the match. Other signals are left to separate the genuinely
 * different people this lets through.
 */
function MTC_tokenSimilarity(tokensA, tokensB) {
  return Math.max(
    MTC_directionalSimilarity(tokensA, tokensB),
    MTC_directionalSimilarity(tokensB, tokensA)
  );
}

/* ------------------------------------------------------------------ *
 * Scoring
 * ------------------------------------------------------------------ */

/**
 * Scores how likely it is that `candidate` (an existing record) is the same
 * human being as `subject` (what someone is typing, or another record).
 *
 * Returns { score, signals }. Signals are kept so the admin reviewing a merge
 * sees WHY the app thinks these are the same person, rather than a bare number
 * they have to trust.
 */
function MTC_score(graph, subject, candidate) {
  var signals = [];
  var score = 0;

  function add(points, name, detail) {
    if (!points) return;
    score += points;
    signals.push({ signal: name, points: points, detail: detail || '' });
  }

  // A stated gender conflict is close to decisive. Records where gender was
  // never captured are not penalised.
  if (subject.gender && candidate.gender &&
      subject.gender !== 'U' && candidate.gender !== 'U') {
    if (subject.gender !== candidate.gender) {
      add(-45, 'gender_conflict', subject.gender + ' vs ' + candidate.gender);
    } else {
      add(4, 'gender_match', subject.gender);
    }
  }

  var subjectName = MTC_parseName(subject.full_name || subject.display_name);
  var candidateName = MTC_parseName(candidate.full_name || candidate.display_name);

  var nameAgreement = MTC_tokenSimilarity(subjectName.own, candidateName.own);
  if (nameAgreement > 0.82) add(Math.round(nameAgreement * 26), 'name_similar', Math.round(nameAgreement * 100) + '%');
  else if (nameAgreement > 0.6) add(Math.round(nameAgreement * 10), 'name_partial', Math.round(nameAgreement * 100) + '%');

  // Nicknames. A relative may enter the name the family actually uses.
  if (MTC_aliasHit(subject, candidateName) || MTC_aliasHit(candidate, subjectName)) {
    add(12, 'nickname_match', '');
    if (nameAgreement < 0.8) nameAgreement = 0.8;
  }

  // Whether the two records agree about who the father was -- scored once,
  // from whichever evidence each side offers.
  var father = MTC_fatherAgreement(graph, subject, subjectName, candidate, candidateName);
  add(father.points, father.signal, father.detail);

  add(MTC_dateScore(subject.birth_date, candidate.birth_date,
                    subject.birth_precision, candidate.birth_precision), 'birth_date', '');
  add(MTC_dateScore(subject.death_date, candidate.death_date, 'exact', 'exact'), 'death_date', '');

  add(MTC_exactFieldScore(subject.email, candidate.email, 45), 'email', '');
  add(MTC_exactFieldScore(MTC_digits(subject.mobile), MTC_digits(candidate.mobile), 35), 'mobile', '');
  add(MTC_fuzzyFieldScore(subject.address, candidate.address, 12), 'address', '');
  add(MTC_fuzzyFieldScore(subject.birth_place, candidate.birth_place, 10), 'birth_place', '');

  // How the two records already sit in the tree relative to each other.
  var structure = MTC_structuralCheck(graph, subject, candidate, nameAgreement);
  for (var i = 0; i < structure.signals.length; i++) {
    signals.push(structure.signals[i]);
  }
  if (structure.veto) {
    return { score: 0, signals: signals, veto: structure.veto };
  }
  score += structure.points;

  if (score > 100) score = 100;
  if (score < 0) score = 0;
  return { score: Math.round(score), signals: signals };
}

/**
 * Do these two records agree about the father?
 *
 * Each side states a father either through a recorded parent link or through
 * the patronymic in its own name, and either kind of evidence answers the same
 * question. Scoring the patronym, the recorded link and the two patronyms
 * against each other as three separate signals counted one fact three times and
 * pushed every pair of siblings towards a merge.
 */
function MTC_fatherAgreement(graph, subject, subjectName, candidate, candidateName) {
  var a = MTC_statedFather(graph, subject, subjectName);
  var b = MTC_statedFather(graph, candidate, candidateName);
  if (!a.tokens.length || !b.tokens.length) {
    return { points: 0, signal: 'father_unknown', detail: '' };
  }

  // Both sides point at the same person record: conclusive, no name matching
  // needed.
  if (a.personId && b.personId && a.personId === b.personId) {
    return { points: 30, signal: 'same_father_record', detail: a.personId };
  }

  var similarity = MTC_tokenSimilarity(a.tokens, b.tokens);
  var detail = a.tokens.join(' ') + ' / ' + b.tokens.join(' ');
  if (similarity > 0.88) return { points: 30, signal: 'father_matches', detail: detail };
  if (similarity > 0.80) return { points: 12, signal: 'father_similar', detail: detail };
  if (similarity < 0.45) return { points: -20, signal: 'father_conflict', detail: detail };
  return { points: 0, signal: 'father_inconclusive', detail: detail };
}

/** A record's father, from a recorded link if there is one, from the
 *  patronymic in the name otherwise. */
function MTC_statedFather(graph, person, parsedName) {
  var fatherId = person.person_id ? MTC_fatherOf(graph, person.person_id) : null;
  if (fatherId && graph.people[fatherId]) {
    var father = graph.people[fatherId];
    return {
      personId: fatherId,
      tokens: MTC_parseName(father.full_name || father.display_name).own
    };
  }
  return { personId: null, tokens: parsedName.patronym };
}

/**
 * What the existing shape of the tree says about the pair.
 *
 * Two people already linked across generations, or married to each other, are
 * categorically not the same person -- and sharing a name across generations is
 * ordinary, so those pairs are vetoed outright rather than merely penalised.
 *
 * Siblings are the exception, and an important one. The commonest way a
 * duplicate enters a family tree is two cousins each adding the same uncle
 * under the same grandparents, which leaves the two copies looking exactly like
 * siblings. Vetoing siblings would therefore blind the matcher to the case it
 * exists for, so a sibling pair is penalised only when the names disagree.
 */
function MTC_structuralCheck(graph, subject, candidate, nameAgreement) {
  var out = { points: 0, signals: [], veto: null };
  if (!graph || !subject.person_id || !candidate.person_id) return out;

  var relation = KIN_relate(graph, subject.person_id, candidate.person_id);
  var vetoed = relation.kind === 'spouse' ||
    (relation.kind === 'blood' &&
      (relation.type === 'ancestor' || relation.type === 'descendant' ||
       relation.type === 'auncle' || relation.type === 'nibling'));

  if (vetoed) {
    out.veto = relation.type || relation.kind;
    out.signals.push({
      signal: 'cannot_be_same_person', points: 0,
      detail: 'already linked as ' + (relation.type || relation.kind)
    });
    return out;
  }

  if (relation.kind === 'blood' && relation.type === 'sibling' && nameAgreement < 0.9) {
    out.points -= 25;
    out.signals.push({ signal: 'recorded_as_siblings', points: -25, detail: '' });
  }

  // Shared relatives are strong evidence of being the same person -- but only
  // alongside some agreement about the name. Without it they merely confirm
  // that the two are related, which siblings and cousins already are.
  var weight = nameAgreement >= 0.75 ? 1 : (nameAgreement >= 0.55 ? 0.4 : 0);
  if (!weight) return out;

  var sharedParents = MTC_intersect(
    KIN_parentsOf(graph, subject.person_id), KIN_parentsOf(graph, candidate.person_id));
  if (sharedParents.length) {
    var parentPoints = Math.round(Math.min(sharedParents.length * 28, 45) * weight);
    out.points += parentPoints;
    out.signals.push({ signal: 'shared_parent', points: parentPoints, detail: sharedParents.join(', ') });
  }

  var sharedSpouses = MTC_intersect(
    MTC_ids(KIN_spousesOf(graph, subject.person_id)),
    MTC_ids(KIN_spousesOf(graph, candidate.person_id)));
  if (sharedSpouses.length) {
    var spousePoints = Math.round(35 * weight);
    out.points += spousePoints;
    out.signals.push({ signal: 'shared_spouse', points: spousePoints, detail: sharedSpouses.join(', ') });
  }

  var sharedChildren = MTC_intersect(
    KIN_childrenOf(graph, subject.person_id), KIN_childrenOf(graph, candidate.person_id));
  if (sharedChildren.length) {
    var childPoints = Math.round(32 * weight);
    out.points += childPoints;
    out.signals.push({ signal: 'shared_child', points: childPoints, detail: sharedChildren.join(', ') });
  }

  return out;
}

function MTC_aliasHit(person, otherName) {
  if (!person.also_known_as) return false;
  var aliases = MTC_normalise(person.also_known_as).split(' ');
  for (var i = 0; i < aliases.length; i++) {
    if (!aliases[i]) continue;
    for (var j = 0; j < otherName.own.length; j++) {
      if (MTC_tokenScore(MTC_canonicalToken(aliases[i]), otherName.own[j]) > 0.9) return true;
    }
  }
  return false;
}

function MTC_fatherOf(graph, personId) {
  var links = (graph.parentsOf || {})[personId] || [];
  for (var i = 0; i < links.length; i++) {
    if (links[i].parent_role === 'father' &&
        (links[i].relation_type === 'biological' || links[i].relation_type === 'adoptive')) {
      return links[i].parent_id;
    }
  }
  return null;
}

/**
 * Elders' birth dates are often recorded as a year, or as an approximation, so
 * a partial agreement is worth something and a partial disagreement is not
 * worth punishing as hard as two conflicting exact dates would be.
 */
function MTC_dateScore(a, b, precisionA, precisionB) {
  if (!a || !b) return 0;
  var strA = String(a).slice(0, 10);
  var strB = String(b).slice(0, 10);
  if (strA === strB) return 26;

  var vague = precisionA === 'about' || precisionB === 'about' ||
              precisionA === 'year' || precisionB === 'year';
  if (strA.slice(0, 7) === strB.slice(0, 7)) return 16;
  if (strA.slice(0, 4) === strB.slice(0, 4)) return vague ? 12 : 9;

  var yearGap = Math.abs(Number(strA.slice(0, 4)) - Number(strB.slice(0, 4)));
  if (vague && yearGap <= 2) return 4;
  return yearGap > 5 ? -30 : -14;
}

function MTC_exactFieldScore(a, b, points) {
  if (!a || !b) return 0;
  return String(a).toLowerCase() === String(b).toLowerCase() ? points : 0;
}

function MTC_fuzzyFieldScore(a, b, points) {
  if (!a || !b) return 0;
  var similarity = MTC_jaroWinkler(MTC_normalise(a), MTC_normalise(b));
  return similarity > 0.85 ? points : 0;
}

function MTC_digits(text) {
  if (!text) return '';
  var digits = String(text).replace(/\D/g, '');
  return digits.length > 8 ? digits.slice(-8) : digits;
}

function MTC_ids(spouseEntries) {
  var out = [];
  for (var i = 0; i < spouseEntries.length; i++) out.push(spouseEntries[i].personId);
  return out;
}

function MTC_intersect(a, b) {
  var out = [];
  for (var i = 0; i < a.length; i++) if (b.indexOf(a[i]) !== -1) out.push(a[i]);
  return out;
}

/* ------------------------------------------------------------------ *
 * Search
 * ------------------------------------------------------------------ */

/**
 * Every existing record that might be the person being described, best first.
 *
 * Called live while someone types a new name, so the app can offer "this might
 * be Ahmad bin Ismail, son of Ismail -- link to him instead?" before a duplicate
 * is ever created.
 */
function MTC_findCandidates(graph, subject, threshold, limit) {
  var results = [];
  for (var id in graph.people) {
    if (!Object.prototype.hasOwnProperty.call(graph.people, id)) continue;
    if (id === subject.person_id) continue;
    var candidate = graph.people[id];
    if (candidate.status !== 'active') continue;

    var scored = MTC_score(graph, subject, candidate);
    if (scored.score >= (threshold || 60)) {
      results.push({ person: candidate, score: scored.score, signals: scored.signals });
    }
  }
  results.sort(function (a, b) { return b.score - a.score; });
  return results.slice(0, limit || 8);
}

/** A full sweep for the admin's merge queue. */
function MTC_sweep(graph, threshold) {
  var ids = [];
  for (var id in graph.people) {
    if (Object.prototype.hasOwnProperty.call(graph.people, id) &&
        graph.people[id].status === 'active') ids.push(id);
  }
  ids.sort();

  var pairs = [];
  for (var i = 0; i < ids.length; i++) {
    for (var j = i + 1; j < ids.length; j++) {
      var scored = MTC_score(graph, graph.people[ids[i]], graph.people[ids[j]]);
      if (scored.score >= (threshold || 68)) {
        pairs.push({ a: ids[i], b: ids[j], score: scored.score, signals: scored.signals });
      }
    }
  }
  pairs.sort(function (x, y) { return y.score - x.score; });
  return pairs;
}

if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    MTC_parseName: MTC_parseName,
    MTC_score: MTC_score,
    MTC_findCandidates: MTC_findCandidates,
    MTC_sweep: MTC_sweep,
    MTC_jaroWinkler: MTC_jaroWinkler
  };
}

/* ================================================================== *
 * 09_Merge.gs                                                    *
 * ================================================================== */

/**
 * Merging two records that turned out to be one person.
 *
 * A merge is the most destructive thing this app does, so it is built to be
 * survivable. The losing record is never deleted: it stays in the sheet marked
 * `merged` with a pointer to the survivor, so an old link, an invite or a
 * relative's bookmark still resolves instead of breaking. Every field the
 * survivor was missing is filled from the loser rather than discarded, because
 * the duplicate usually exists precisely because someone knew something the
 * first record did not.
 */

/**
 * @param keepId the record that survives
 * @param loseId the record folded into it
 * @param fieldChoices optional per-field overrides picked by the admin
 */
function MRG_merge(session, keepId, loseId, fieldChoices) {
  AUTH_requireAdmin(session);
  if (keepId === loseId) throw new Error('Those are the same record.');

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var graph = ST_graph();
    var keep = graph.people[keepId];
    var lose = graph.people[loseId];
    if (!keep || !lose) throw new Error('One of those records no longer exists.');

    var before = { keep: keep, lose: lose };

    MRG_mergeFields(keep, lose, fieldChoices);
    MRG_repointParentage(keepId, loseId);
    MRG_repointUnions(keepId, loseId);
    MRG_repointReferences(keepId, loseId);

    ST_update('People', 'person_id', loseId, {
      status: 'merged',
      merged_into_id: keepId,
      updated_by: session.email,
      updated_at: ST_now()
    });

    ST_audit(session.email, 'merge_people', 'People', keepId,
      { merged: loseId, before: before });
    ST_invalidate();

    return { status: 'merged', keptId: keepId, removedId: loseId };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Fills the survivor's empty fields from the loser.
 *
 * Only blanks are filled by default: a value someone deliberately entered on
 * the surviving record is never silently replaced. Where both records hold
 * different values the admin's choice decides, and where they made no choice
 * the survivor keeps what it had.
 */
function MRG_mergeFields(keep, lose, fieldChoices) {
  var patch = {};
  var fields = SCHEMA.People;

  for (var i = 0; i < fields.length; i++) {
    var field = fields[i];
    if (['person_id', 'status', 'merged_into_id', 'created_by', 'created_at',
         'updated_by', 'updated_at'].indexOf(field) !== -1) continue;

    var chosen = fieldChoices && fieldChoices[field];
    if (chosen === 'lose' && lose[field] !== '') {
      patch[field] = lose[field];
      continue;
    }
    if (chosen === 'keep') continue;
    if ((keep[field] === '' || keep[field] === undefined) && lose[field] !== '') {
      patch[field] = lose[field];
    }
  }

  // Nicknames are additive: both records may know a name the family uses.
  var aliases = MRG_mergeAliases(keep.also_known_as, lose.also_known_as);
  if (aliases) patch.also_known_as = aliases;

  patch.updated_at = ST_now();
  ST_update('People', 'person_id', keep.person_id, patch);
}

function MRG_mergeAliases(a, b) {
  var seen = {};
  var out = [];
  var parts = (String(a || '') + ',' + String(b || '')).split(',');
  for (var i = 0; i < parts.length; i++) {
    var value = parts[i].replace(/^\s+|\s+$/g, '');
    if (!value) continue;
    var key = value.toLowerCase();
    if (seen[key]) continue;
    seen[key] = true;
    out.push(value);
  }
  return out.join(', ');
}

/**
 * Moves the loser's parent and child links onto the survivor.
 *
 * Links that would duplicate one the survivor already has are retired rather
 * than moved, otherwise the survivor ends up recorded as having four parents.
 */
function MRG_repointParentage(keepId, loseId) {
  var rows = ST_readAll('Parentage');
  var existing = {};
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].status !== 'active') continue;
    if (rows[i].child_id === keepId) existing['c:' + rows[i].parent_id] = true;
    if (rows[i].parent_id === keepId) existing['p:' + rows[i].child_id] = true;
  }

  for (var j = 0; j < rows.length; j++) {
    var row = rows[j];
    if (row.status !== 'active') continue;

    if (row.child_id === loseId) {
      if (existing['c:' + row.parent_id] || row.parent_id === keepId) {
        ST_update('Parentage', 'link_id', row.link_id, { status: 'removed' });
      } else {
        ST_update('Parentage', 'link_id', row.link_id, { child_id: keepId });
        existing['c:' + row.parent_id] = true;
      }
    }

    if (row.parent_id === loseId) {
      if (existing['p:' + row.child_id] || row.child_id === keepId) {
        ST_update('Parentage', 'link_id', row.link_id, { status: 'removed' });
      } else {
        ST_update('Parentage', 'link_id', row.link_id, { parent_id: keepId });
        existing['p:' + row.child_id] = true;
      }
    }
  }
}

function MRG_repointUnions(keepId, loseId) {
  var rows = ST_readAll('Unions');
  var partners = {};
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].partner_a_id === keepId) partners[rows[i].partner_b_id] = true;
    if (rows[i].partner_b_id === keepId) partners[rows[i].partner_a_id] = true;
  }

  for (var j = 0; j < rows.length; j++) {
    var row = rows[j];
    var isA = row.partner_a_id === loseId;
    var isB = row.partner_b_id === loseId;
    if (!isA && !isB) continue;

    var other = isA ? row.partner_b_id : row.partner_a_id;
    if (other === keepId || partners[other]) {
      ST_update('Unions', 'union_id', row.union_id, { status: 'superseded' });
      continue;
    }
    ST_update('Unions', 'union_id', row.union_id,
      isA ? { partner_a_id: keepId } : { partner_b_id: keepId });
    partners[other] = true;
  }
}

/** Logins, custom titles and open merge candidates that pointed at the loser. */
function MRG_repointReferences(keepId, loseId) {
  var users = ST_readAll('Users');
  for (var i = 0; i < users.length; i++) {
    if (users[i].person_id === loseId) {
      ST_update('Users', 'email', users[i].email, { person_id: keepId });
    }
  }

  var titles = ST_readAll('CustomTitles');
  for (var j = 0; j < titles.length; j++) {
    var patch = {};
    if (titles[j].from_person_id === loseId) patch.from_person_id = keepId;
    if (titles[j].to_person_id === loseId) patch.to_person_id = keepId;
    if (Object.keys(patch).length) ST_update('CustomTitles', 'title_id', titles[j].title_id, patch);
  }

  var queue = ST_readAll('MergeQueue');
  for (var k = 0; k < queue.length; k++) {
    if (queue[k].status !== 'open') continue;
    if (queue[k].person_a_id === loseId || queue[k].person_b_id === loseId) {
      ST_update('MergeQueue', 'candidate_id', queue[k].candidate_id,
        { status: 'merged', resolved_at: ST_now() });
    }
  }
}

/* ------------------------------------------------------------------ *
 * The queue
 * ------------------------------------------------------------------ */

/**
 * Re-scans the whole tree for duplicates.
 *
 * Pairs an admin has already dismissed stay dismissed -- being told twice that
 * two people are the same person when you have just confirmed they are not is
 * how review queues get ignored.
 */
function MRG_rebuildQueue(session) {
  AUTH_requireAdmin(session);
  var graph = ST_graph();
  var settings = ST_settings();
  var pairs = MTC_sweep(graph, Number(settings.merge_queue_threshold) || 68);

  var existing = ST_readAll('MergeQueue');
  var known = {};
  for (var i = 0; i < existing.length; i++) {
    known[existing[i].person_a_id + '|' + existing[i].person_b_id] = existing[i];
  }

  var added = [];
  for (var j = 0; j < pairs.length; j++) {
    var pair = pairs[j];
    var key = pair.a + '|' + pair.b;
    if (known[key]) continue;

    added.push({
      candidate_id: ST_nextId('MergeQueue'),
      person_a_id: pair.a,
      person_b_id: pair.b,
      score: pair.score,
      signals_json: JSON.stringify(pair.signals),
      detected_at: ST_now(),
      status: 'open',
      resolved_by: '',
      resolved_at: ''
    });
  }

  if (added.length) ST_appendMany('MergeQueue', added);
  ST_audit(session.email, 'rebuild_merge_queue', 'MergeQueue', '',
    { scanned: pairs.length, added: added.length });
  return { found: pairs.length, added: added.length };
}

function MRG_dismiss(session, candidateId, note) {
  AUTH_requireAdmin(session);
  ST_update('MergeQueue', 'candidate_id', candidateId, {
    status: 'rejected', resolved_by: session.email, resolved_at: ST_now()
  });
  ST_audit(session.email, 'dismiss_merge', 'MergeQueue', candidateId, { note: note || '' });
  return { status: 'dismissed' };
}

/* ================================================================== *
 * 10_Admin.gs                                                    *
 * ================================================================== */

/**
 * The admin side: approvals, invitations and access.
 */

/* ------------------------------------------------------------------ *
 * Approvals
 * ------------------------------------------------------------------ */

function ADM_pendingChanges(session) {
  AUTH_requireAdmin(session);
  var rows = ST_readAll('PendingChanges');
  var out = [];
  for (var i = rows.length - 1; i >= 0; i--) {
    if (rows[i].status !== 'pending') continue;
    out.push({
      changeId: rows[i].change_id,
      kind: rows[i].kind,
      summary: rows[i].summary,
      requestedBy: rows[i].requested_by,
      requestedAt: rows[i].requested_at,
      payload: ADM_parseJson(rows[i].payload_json)
    });
  }
  return out;
}

/**
 * Applies a queued change exactly as it was submitted.
 *
 * The stored payload is replayed rather than re-derived, so what the admin read
 * on screen is what actually happens. A change that fails is recorded as
 * rejected with the reason attached, so it neither disappears nor sits in the
 * queue being retried forever.
 */
function ADM_approve(session, changeId, note) {
  AUTH_requireAdmin(session);

  var rows = ST_readAll('PendingChanges');
  var change = null;
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].change_id === changeId) { change = rows[i]; break; }
  }
  if (!change) throw new Error('That request no longer exists.');
  if (change.status !== 'pending') throw new Error('That request has already been reviewed.');

  var payload = ADM_parseJson(change.payload_json);
  if (!payload) throw new Error('That request could not be read.');

  try {
    ADM_applyChange(session, change, payload);
  } catch (err) {
    ST_update('PendingChanges', 'change_id', changeId, {
      status: 'rejected', reviewed_by: session.email, reviewed_at: ST_now(),
      review_note: 'Could not be applied: ' + err.message
    });
    throw err;
  }

  ST_update('PendingChanges', 'change_id', changeId, {
    status: 'approved', reviewed_by: session.email, reviewed_at: ST_now(),
    review_note: note || ''
  });
  ST_audit(session.email, 'approve_change', 'PendingChanges', changeId, payload);
  ST_invalidate();
  return { status: 'approved' };
}

function ADM_applyChange(session, change, payload) {
  // The change is credited to whoever proposed it, not to the admin who let it
  // through -- the audit trail should say who knew this, not who clicked yes.
  var author = change.requested_by;

  switch (change.kind) {
    case 'create_person':
      PPL_applyCreate(author, payload.anchorId, payload.relationship, payload.data);
      return;
    case 'update_person':
      PPL_applyUpdate(author, payload.personId, payload.changes);
      return;
    case 'delete_person':
      PPL_applyDelete(author, payload.personId);
      return;
    case 'add_parentage':
      PPL_addParentLink(author, payload.childId, payload.parentId,
        payload.role, payload.relationType);
      return;
    case 'add_union':
      PPL_addUnion(author, payload.aId, payload.bId, payload.data || {});
      return;
    case 'add_batch':
      PPL_applyBatch(author, payload.anchorId, payload.relationship, payload.rows);
      return;
    case 'upload_photo':
      PHO_store(author, payload.personId, payload.payload);
      return;
    default:
      throw new Error('Unknown request type: ' + change.kind);
  }
}

function ADM_reject(session, changeId, note) {
  AUTH_requireAdmin(session);
  ST_update('PendingChanges', 'change_id', changeId, {
    status: 'rejected', reviewed_by: session.email, reviewed_at: ST_now(),
    review_note: note || ''
  });
  ST_audit(session.email, 'reject_change', 'PendingChanges', changeId, { note: note || '' });
  return { status: 'rejected' };
}

/* ------------------------------------------------------------------ *
 * Invitations
 * ------------------------------------------------------------------ */

/**
 * Invites someone, optionally bound to a record that already exists.
 *
 * Binding is what stops a relative creating a second copy of themselves on
 * their first visit: if the family already added them, the invite ties their
 * Google account to that record the moment they sign in.
 *
 * Ordinary members may invite too, which is how the tree spreads through a
 * family without the owner being a bottleneck -- but only into their own branch.
 * Inviting a stranger to a record on the far side of the family is not theirs
 * to do.
 */
function ADM_invite(session, email, prebindPersonId) {
  AUTH_requireActive(session);
  var settings = ST_settings();

  if (!session.isAdmin) {
    if (!session.canInvite || String(settings.allow_member_invites).toUpperCase() !== 'TRUE') {
      throw new Error('Ask a family tree admin to send that invitation.');
    }
    if (prebindPersonId && !AUTH_canEditDirectly(session, ST_graph(), prebindPersonId)) {
      throw new Error('You can only invite people in your own part of the family.');
    }
  }

  var clean = String(email || '').toLowerCase().replace(/^\s+|\s+$/g, '');
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(clean)) throw new Error('That is not a valid email address.');

  var users = ST_readAll('Users');
  for (var i = 0; i < users.length; i++) {
    if (String(users[i].email).toLowerCase() === clean) {
      throw new Error('That person can already sign in.');
    }
  }

  var days = Number(settings.invite_expiry_days) || 30;
  var expires = new Date();
  expires.setDate(expires.getDate() + days);

  // The invitation is bound to the email address, not to a secret in a link:
  // the person must sign in with that exact Google account, so a forwarded URL
  // admits nobody. The token is kept only as a record of the invitation.
  var invite = {
    invite_id: ST_nextId('Invites'),
    email: clean,
    token: Utilities.getUuid(),
    prebind_person_id: prebindPersonId || '',
    invited_by: session.email,
    created_at: ST_now(),
    expires_at: Utilities.formatDate(expires, Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ss"),
    used_at: '',
    status: 'open'
  };
  ST_append('Invites', invite);
  ST_audit(session.email, 'invite', 'Invites', invite.invite_id, { email: clean });

  return {
    status: 'invited',
    email: clean,
    url: ScriptApp.getService().getUrl(),
    expiresAt: invite.expires_at
  };
}

function ADM_revokeInvite(session, inviteId) {
  AUTH_requireAdmin(session);
  ST_update('Invites', 'invite_id', inviteId, { status: 'revoked' });
  return { status: 'revoked' };
}

