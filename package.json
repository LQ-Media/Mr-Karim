{
  "name": "mr-karim",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create mr-karim",
    "db:migrate": "wrangler d1 execute mr-karim --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute mr-karim --local --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.136.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0"
  }
}
