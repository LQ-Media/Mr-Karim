# Silat & Solat — settings for Railway (Variables tab) or .env.local.
# Every one is optional for a first look: with none, the public pages work and
# sign-in, payments and member pages stay off.

# The site's public address, e.g. https://silat-solat.up.railway.app
APP_ORIGIN=

# Railway Postgres: add a Postgres service and reference its DATABASE_URL.
DATABASE_URL=
# A long random string that signs sign-in cookies and check-in QR codes.
SESSION_SECRET=

# "Continue with Google": Google Cloud > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorised redirect URI:
#   <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that are always admin (the Ustaz, Nur, the volunteer admin).
ADMIN_EMAILS=

# PayNow into the Silat n Solat account: its UEN, or else a mobile number.
PAYNOW_UEN=
PAYNOW_MOBILE=
PAYNOW_NAME="SILAT N SOLAT"

# Card payments: Silat n Solat's OWN Stripe account (never another business's).
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > endpoint <APP_ORIGIN>/api/stripe/webhook with
# checkout.session.completed, invoice.paid, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=

# The book, in cents, until the real price is set.
BOOK_PRICE_CENTS=1500
BOOK_POSTAGE_CENTS=300

# 1 = show the ten drafted Tanya Ustaz answers publicly (only once the Ustaz approves them).
FAQ_APPROVED=
# 1 = let search engines index the site (when the Ustaz says go public).
ALLOW_INDEXING=
